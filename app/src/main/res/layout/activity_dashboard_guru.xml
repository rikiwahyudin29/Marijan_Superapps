<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_animated_gradient">

    <!-- GLOBAL HEADER (From Beranda) -->
    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="12dp"
        android:background="@android:color/transparent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp">

            <!-- Logo & Text -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_centerVertical="true">
                
                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/logo_marj" />
                    
                <TextView
                    android:id="@+id/tvAppTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SMK RJ SuperApps"
                    android:textColor="#1A1B41"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginStart="8dp" />
            </LinearLayout>

            <!-- Profile Pic -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cvProfilPic"
                android:layout_width="40dp"
                android:layout_height="40dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:clickable="true"
                android:foreground="?attr/selectableItemBackground">
                
                <ImageView
                    android:id="@+id/ivProfilPhoto"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@android:drawable/ic_menu_myplaces"
                    android:scaleType="centerCrop"/>
            </androidx.cardview.widget.CardView>
        </RelativeLayout>

        <!-- GREETING -->
        <TextView
            android:id="@+id/tvNamaDashboard"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Selamat Datang, Guru!"
            android:textSize="22sp"
            android:textColor="#1A1B41"
            android:textStyle="bold" />
            
        <TextView
            android:id="@+id/tvKelas"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Memuat Kelas..."
            android:textSize="14sp"
            android:textColor="#6B7280"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <!-- ViewPager for Fragments -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/headerLayout"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigation" />

    <!-- Bottom Navigation Area -->
    <LinearLayout
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        app:layout_constraintBottom_toBottomOf="parent"
        android:background="@android:color/transparent"
        android:elevation="0dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingHorizontal="4dp"
        android:weightSum="4">

            <!-- 1. Beranda -->
            <LinearLayout
                android:id="@+id/navBeranda"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <ImageView
                    android:id="@+id/ivNavBeranda"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_modern_home"
                    app:tint="#1E3A8A" />

                <TextView
                    android:id="@+id/tvNavBeranda"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Beranda"
                    android:textColor="#1E3A8A"
                    android:textStyle="bold"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- 2. Presensi -->
            <LinearLayout
                android:id="@+id/navPresensi"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:layout_marginEnd="20dp"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <ImageView
                    android:id="@+id/ivNavPresensi"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_modern_presensi"
                    app:tint="#9CA3AF" />

                <TextView
                    android:id="@+id/tvNavPresensi"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Presensi"
                    android:textColor="#9CA3AF"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- 3. Akademik -->
            <LinearLayout
                android:id="@+id/navAkademik"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:layout_marginStart="20dp"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <ImageView
                    android:id="@+id/ivNavAkademik"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_modern_akademik"
                    app:tint="#9CA3AF" />

                <TextView
                    android:id="@+id/tvNavAkademik"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Akademik"
                    android:textColor="#9CA3AF"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- 4. Profil -->
            <LinearLayout
                android:id="@+id/navProfil"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <ImageView
                    android:id="@+id/ivNavProfil"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_modern_profile"
                    app:tint="#9CA3AF" />

                <TextView
                    android:id="@+id/tvNavProfil"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Profil"
                    android:textColor="#9CA3AF"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>
        
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabScanner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="35dp"
        android:src="@drawable/ic_qr_code"
        app:backgroundTint="#1E3A8A"
        app:tint="#FFFFFF"
        app:elevation="20dp"
        app:fabSize="normal" />

</androidx.constraintlayout.widget.ConstraintLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bottomNavigation"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingHorizontal="6dp"
    android:paddingVertical="6dp">

    <!-- 1. Beranda -->
    <LinearLayout
        android:id="@+id/navBeranda"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_nav_capsule_active"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="9dp"
        android:clickable="true">

        <ImageView
            android:id="@+id/ivNavBeranda"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_modern_home"
            app:tint="#FFFFFF" />

        <TextView
            android:id="@+id/tvNavBeranda"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="Beranda"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="visible" />
    </LinearLayout>

    <!-- 2. Akademik -->
    <LinearLayout
        android:id="@+id/navAkademik"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:background="@drawable/bg_nav_capsule_inactive"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="6dp"
        android:paddingVertical="9dp"
        android:clickable="true">

        <ImageView
            android:id="@+id/ivNavAkademik"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_modern_akademik"
            app:tint="#94A3B8" />

        <TextView
            android:id="@+id/tvNavAkademik"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="Akademik"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <!-- 3. CBT -->
    <LinearLayout
        android:id="@+id/navCbt"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:background="@drawable/bg_nav_capsule_inactive"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="6dp"
        android:paddingVertical="9dp"
        android:clickable="true">

        <ImageView
            android:id="@+id/ivNavCbt"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_modern_cbt"
            app:tint="#94A3B8" />

        <TextView
            android:id="@+id/tvNavCbt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="CBT"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <!-- 4. Presensi -->
    <LinearLayout
        android:id="@+id/navPresensi"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:background="@drawable/bg_nav_capsule_inactive"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="6dp"
        android:paddingVertical="9dp"
        android:clickable="true">

        <ImageView
            android:id="@+id/ivNavPresensi"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_modern_presensi"
            app:tint="#94A3B8" />

        <TextView
            android:id="@+id/tvNavPresensi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="Presensi"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <!-- 5. Keuangan -->
    <LinearLayout
        android:id="@+id/navKeuangan"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:background="@drawable/bg_nav_capsule_inactive"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="6dp"
        android:paddingVertical="9dp"
        android:clickable="true">

        <ImageView
            android:id="@+id/ivNavKeuangan"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_modern_keuangan"
            app:tint="#94A3B8" />

        <TextView
            android:id="@+id/tvNavKeuangan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="Keuangan"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <!-- 6. Profil -->
    <LinearLayout
        android:id="@+id/navProfil"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:background="@drawable/bg_nav_capsule_inactive"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="6dp"
        android:paddingVertical="9dp"
        android:clickable="true">

        <ImageView
            android:id="@+id/ivNavProfil"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_modern_profile"
            app:tint="#94A3B8" />

        <TextView
            android:id="@+id/tvNavProfil"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="Profil"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>

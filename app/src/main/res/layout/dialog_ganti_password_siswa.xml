<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet"
    android:backgroundTint="#FFFFFF"
    android:padding="20dp">

    <!-- Handle Bar -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:background="@drawable/bg_rounded_border"
        android:backgroundTint="#CBD5E1"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ganti Password Akun Siswa"
        android:textColor="#0F172A"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Masukkan password lama Anda dan tentukan password baru yang aman"
        android:textColor="#64748B"
        android:textSize="11.5sp"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="16dp" />

    <!-- Password Lama -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Password Lama"
        android:textColor="#475569"
        android:textSize="11.5sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etPasswordLamaSiswa"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:background="@drawable/bg_input_rounded"
        android:hint="Masukkan password saat ini"
        android:inputType="textPassword"
        android:paddingHorizontal="14dp"
        android:textColor="#0F172A"
        android:textSize="13sp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="12dp" />

    <!-- Password Baru -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Password Baru (Minimal 6 Karakter)"
        android:textColor="#475569"
        android:textSize="11.5sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etPasswordBaruSiswa"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:background="@drawable/bg_input_rounded"
        android:hint="Minimal 6 karakter"
        android:inputType="textPassword"
        android:paddingHorizontal="14dp"
        android:textColor="#0F172A"
        android:textSize="13sp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="12dp" />

    <!-- Konfirmasi Password Baru -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ulangi Password Baru"
        android:textColor="#475569"
        android:textSize="11.5sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etKonfirmasiPasswordBaruSiswa"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:background="@drawable/bg_input_rounded"
        android:hint="Ulangi password baru persis sama"
        android:inputType="textPassword"
        android:paddingHorizontal="14dp"
        android:textColor="#0F172A"
        android:textSize="13sp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="20dp" />

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnBatalGantiPwSiswa"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:text="Batal"
            android:textColor="#64748B"
            android:textSize="12.5sp"
            android:textStyle="bold"
            android:gravity="center"
            android:background="@drawable/bg_rounded_border"
            android:backgroundTint="#F1F5F9"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground" />

        <TextView
            android:id="@+id/btnSimpanGantiPwSiswa"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="Ganti Password"
            android:textColor="#FFFFFF"
            android:textSize="12.5sp"
            android:textStyle="bold"
            android:gravity="center"
            android:background="@drawable/bg_rounded_border"
            android:backgroundTint="#1E1B4B"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground" />
    </LinearLayout>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_animated_gradient"
    tools:ignore="HardcodedText,ContentDescription,Autofill,UseCompoundDrawables">

    <!-- 1. APPBAR / TOOLBAR (Senada dengan Rekap Mengajar & Jadwal Mengajar) -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:background="@android:color/transparent"
        android:elevation="2dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_baseline_arrow_back_24"
            app:tint="#1E293B"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true" />

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="14dp"
            android:src="@drawable/logo_marj" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SMK RJ SUPERAPPS"
                android:textSize="9sp"
                android:letterSpacing="0.05"
                android:textColor="#64748B"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Absen Harian Manual"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#1E293B" />
        </LinearLayout>

        <!-- Profile Pic (Sama seperti Jadwal & Rekap Mengajar) -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cvProfilPic"
            android:layout_width="36dp"
            android:layout_height="36dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            android:clickable="true"
            android:foreground="?attr/selectableItemBackground">

            <ImageView
                android:id="@+id/ivProfilPhoto"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@android:drawable/ic_menu_myplaces"
                android:scaleType="centerCrop" />
        </androidx.cardview.widget.CardView>
    </LinearLayout>

    <!-- 2. SCROLLABLE CONTENT -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollViewContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- BANNER HEADER (Gradient Blue) -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="18dp"
                app:cardElevation="3dp"
                android:layout_marginBottom="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_banner_absen_wali"
                    android:padding="18dp">

                    <!-- Baris Atas: Badge Kelas & TA -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:id="@+id/tvKelasBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="12 TKJT 1"
                            android:textColor="#FFFFFF"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:background="@drawable/bg_rounded_border"
                            android:backgroundTint="#33FFFFFF"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="3dp"
                            android:layout_marginEnd="6dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Kelas Binaan"
                            android:textColor="#FFFFFF"
                            android:textSize="11sp"
                            android:background="@drawable/bg_rounded_border"
                            android:backgroundTint="#33FFFFFF"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="3dp" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />

                        <TextView
                            android:id="@+id/tvTahunAjaran"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="TA 2024/2025"
                            android:textColor="#E0E7FF"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Judul Presensi & Nama Wali Kelas -->
                    <TextView
                        android:id="@+id/tvJudulPresensi"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Presensi Siswa 12 TKJT 1"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvWaliKelasNama"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Wali Kelas: Riki Wahyudin, S.Kom."
                        android:textColor="#E0E7FF"
                        android:textSize="12sp"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="16dp" />

                    <!-- 4 Metric Boxes (Hadir, Sakit, Izin, Alpha) -->
                    <LinearLayout
                        android:id="@+id/llMetricBoxes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <!-- Box Hadir -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="4dp"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:paddingVertical="10dp"
                            android:background="@drawable/bg_box_metric_trans">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Hadir"
                                android:textColor="#A7F3D0"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvCountHadir"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textColor="#FFFFFF"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>

                        <!-- Box Sakit -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginHorizontal="3dp"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:paddingVertical="10dp"
                            android:background="@drawable/bg_box_metric_trans">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Sakit"
                                android:textColor="#BFDBFE"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvCountSakit"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textColor="#FFFFFF"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>

                        <!-- Box Izin -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginHorizontal="3dp"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:paddingVertical="10dp"
                            android:background="@drawable/bg_box_metric_trans">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Izin"
                                android:textColor="#FDE68A"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvCountIzin"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textColor="#FFFFFF"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>

                        <!-- Box Alpha -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="4dp"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:paddingVertical="10dp"
                            android:background="@drawable/bg_box_metric_trans">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Alpha"
                                android:textColor="#FECDD3"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvCountAlpha"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textColor="#FFFFFF"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>

                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- CARD PENGATURAN TANGGAL & FAST ACTION -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:background="#FFFFFF">

                    <!-- Baris 1: Tanggal Picker -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:src="@drawable/ic_modern_clock"
                            android:background="@drawable/bg_icon_circle"
                            android:backgroundTint="#EFF6FF"
                            app:tint="#2563EB"
                            android:padding="8dp"
                            android:layout_marginEnd="10dp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Pilih Tanggal Absen"
                                android:textColor="#64748B"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/tvTanggalDipilih"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Memuat Tanggal..."
                                android:textColor="#1E293B"
                                android:textSize="13.5sp"
                                android:textStyle="bold"
                                android:layout_marginTop="1dp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/btnUbahTanggal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Ubah ⌵"
                            android:textColor="#2563EB"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:background="@drawable/bg_rounded_border"
                            android:backgroundTint="#EFF6FF"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="5dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackground" />
                    </LinearLayout>

                    <!-- Container Fast Action & Search (Disembunyikan saat hari libur) -->
                    <LinearLayout
                        android:id="@+id/llFastActionAndSearch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- Divider -->
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#F1F5F9"
                            android:layout_marginVertical="14dp" />

                        <!-- Baris 2: Fast Action Label -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="8dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="SET KEHADIRAN SEMUA:"
                                android:textColor="#475569"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="1 Tap Sekaligus"
                                android:textColor="#94A3B8"
                                android:textSize="10sp" />
                        </LinearLayout>

                        <!-- 4 Tombol Cepat (Hadir, Sakit, Izin, Alpha) -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="14dp">

                            <!-- Semua Hadir -->
                            <TextView
                                android:id="@+id/btnSetSemuaHadir"
                                android:layout_width="0dp"
                                android:layout_height="36dp"
                                android:layout_weight="1"
                                android:layout_marginEnd="3dp"
                                android:gravity="center"
                                android:text="● Hadir"
                                android:textColor="#059669"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:background="@drawable/bg_rounded_border"
                                android:backgroundTint="#ECFDF5"
                                android:clickable="true"
                                android:focusable="true" />

                            <!-- Semua Sakit -->
                            <TextView
                                android:id="@+id/btnSetSemuaSakit"
                                android:layout_width="0dp"
                                android:layout_height="36dp"
                                android:layout_weight="1"
                                android:layout_marginHorizontal="2.5dp"
                                android:gravity="center"
                                android:text="● Sakit"
                                android:textColor="#2563EB"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:background="@drawable/bg_rounded_border"
                                android:backgroundTint="#EFF6FF"
                                android:clickable="true"
                                android:focusable="true" />

                            <!-- Semua Izin -->
                            <TextView
                                android:id="@+id/btnSetSemuaIzin"
                                android:layout_width="0dp"
                                android:layout_height="36dp"
                                android:layout_weight="1"
                                android:layout_marginHorizontal="2.5dp"
                                android:gravity="center"
                                android:text="● Izin"
                                android:textColor="#D97706"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:background="@drawable/bg_rounded_border"
                                android:backgroundTint="#FEF3C7"
                                android:clickable="true"
                                android:focusable="true" />

                            <!-- Semua Alpha -->
                            <TextView
                                android:id="@+id/btnSetSemuaAlpha"
                                android:layout_width="0dp"
                                android:layout_height="36dp"
                                android:layout_weight="1"
                                android:layout_marginStart="3dp"
                                android:gravity="center"
                                android:text="● Alpha"
                                android:textColor="#DC2626"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:background="@drawable/bg_rounded_border"
                                android:backgroundTint="#FEF2F2"
                                android:clickable="true"
                                android:focusable="true" />
                        </LinearLayout>

                        <!-- Baris 3: Search Bar -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="42dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:background="@drawable/bg_input_rounded"
                            android:paddingHorizontal="12dp">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:src="@drawable/ic_modern_tugas"
                                app:tint="#94A3B8"
                                android:layout_marginEnd="8dp" />

                            <EditText
                                android:id="@+id/etCariSiswa"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@android:color/transparent"
                                android:hint="Cari nama siswa atau NISN..."
                                android:textColor="#0F172A"
                                android:textColorHint="#94A3B8"
                                android:textSize="12.5sp"
                                android:singleLine="true" />
                        </LinearLayout>
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- TAMPILAN STATE HARI LIBUR (Hanya Muncul Jika Hari Libur) -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cvStateHariLibur"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                android:layout_marginBottom="16dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingHorizontal="24dp"
                    android:paddingVertical="36dp"
                    android:background="#FFFBEB">

                    <ImageView
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:src="@drawable/ic_modern_kalender"
                        android:background="@drawable/bg_icon_circle"
                        android:backgroundTint="#FEF3C7"
                        app:tint="#D97706"
                        android:padding="14dp"
                        android:layout_marginBottom="16dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hari Ini Libur"
                        android:textColor="#92400E"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvKeteranganLibur"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Libur Akhir Pekan (Sabtu)"
                        android:textColor="#B45309"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tidak ada kegiatan presensi atau pembelajaran pada tanggal ini. Daftar siswa dan penyimpanan absensi dinonaktifkan."
                        android:textColor="#78350F"
                        android:textSize="12sp"
                        android:gravity="center"
                        android:lineSpacingExtra="2dp" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- SECTION HEADER: DAFTAR SISWA -->
            <LinearLayout
                android:id="@+id/llHeaderDaftarSiswa"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/tvDaftarSiswaHeader"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="DAFTAR SISWA (0)"
                    android:textColor="#1E3A8A"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnUrutkanSiswa"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Urut Nomor Absen ⇅"
                    android:textColor="#2563EB"
                    android:textSize="11.5sp"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="4dp" />
            </LinearLayout>

            <!-- Loading Indicator (Lottie) -->
            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/pbLoading"
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:layout_gravity="center"
                android:layout_marginVertical="24dp"
                app:lottie_url="https://lottie.host/ff71b2dd-787e-4f88-9f79-79f0eb2c8641/OqV9rU5oMu.json"
                app:lottie_autoPlay="true"
                app:lottie_loop="true" />

            <!-- Empty State -->
            <TextView
                android:id="@+id/tvEmptyState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tidak ada siswa ditemukan"
                android:textColor="#64748B"
                android:textSize="13sp"
                android:gravity="center"
                android:layout_marginVertical="30dp"
                android:visibility="gone" />

            <!-- RECYCLERVIEW DAFTAR SISWA -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvDaftarSiswa"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- 3. STICKY BOTTOM BAR -->
    <androidx.cardview.widget.CardView
        android:id="@+id/bottomStickyBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardElevation="12dp"
        app:cardCornerRadius="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="16dp"
            android:background="#FFFFFF">

            <!-- Baris Progres Kelengkapan -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_modern_presensi"
                    app:tint="#059669"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:id="@+id/tvProgressAbsen"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="0 dari 0 Siswa telah diabsen"
                    android:textColor="#1E293B"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvBadgeStatusLengkap"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="100% Lengkap"
                    android:textColor="#059669"
                    android:textSize="10.5sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_rounded_border"
                    android:backgroundTint="#ECFDF5"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp" />
            </LinearLayout>

            <!-- Baris Tombol: Batal & Simpan Kehadiran -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- Tombol Batal -->
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnBatal"
                    android:layout_width="100dp"
                    android:layout_height="46dp"
                    android:text="Batal"
                    android:textColor="#475569"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_btn_outline"
                    android:layout_marginEnd="10dp" />

                <!-- Tombol Simpan Kehadiran -->
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnSimpanKehadiran"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:text="Simpan Kehadiran →"
                    android:textColor="#FFFFFF"
                    android:textSize="13.5sp"

<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <!-- Top Row Badges -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tvKategoriUjian"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_pill_cyan_badge"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="ASESMEN CBT"
                android:textColor="#0369A1"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_pill_green_badge"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="● Tersedia"
                android:textColor="#15803D"
                android:textSize="11sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- Exam Title -->
        <TextView
            android:id="@+id/tvMapelJudul"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Konfigurasi Perangkat Jaringan"
            android:textColor="#0F172A"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Exam Description / Subtitle -->
        <TextView
            android:id="@+id/tvDeskripsiUjian"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="12dp"
            android:text="Penilaian Sumatif Akhir Semester • Pilihan Ganda &amp; Uraian"
            android:textColor="#64748B"
            android:textSize="12sp" />

        <!-- Inner Info Box -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_white"
            android:backgroundTint="#F8FAFC"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- Item 1: Waktu -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_modern_clock"
                    app:tint="#2563EB" />

                <TextView
                    android:id="@+id/tvRentangWaktu"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="2026-09-08 08:00 s/d 22:00 WIB"
                    android:textColor="#1E293B"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvSubRentangWaktu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="1dp"
                android:text="Sisa waktu pengerjaan hari ini"
                android:textColor="#64748B"
                android:textSize="11sp" />

            <!-- Item 2: Durasi & Soal -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_timer_stopwatch"
                    app:tint="#0D9488" />

                <TextView
                    android:id="@+id/tvDurasiSoal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Durasi: 90 Menit • 40 Butir Soal"
                    android:textColor="#1E293B"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvTipeSoal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="1dp"
                android:text="Pilihan Ganda, PG Kompleks &amp; Uraian"
                android:textColor="#64748B"
                android:textSize="11sp" />

            <!-- Item 3: Node Server -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_server_storage"
                    app:tint="#64748B" />

                <TextView
                    android:id="@+id/tvServerNode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="CBT Node 01 • TKJT High-Speed Dedicated Server"
                    android:textColor="#475569"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Tombol Mulai Ujian -->
        <androidx.cardview.widget.CardView
            android:id="@+id/btnMulaiUjianCard"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="14dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="1dp"
            app:cardBackgroundColor="#1E1B4B"
            android:clipToOutline="true"
            android:clickable="true"
            android:foreground="@drawable/ripple_rounded_14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ivBtnIconStart"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_play_video"
                    app:tint="#FFFFFF" />

                <TextView
                    android:id="@+id/tvBtnMulaiText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="10dp"
                    android:text="MULAI UJIAN SEKARANG"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/ivBtnIconEnd"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_arrow_forward_small"
                    app:tint="#FFFFFF" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</androidx.cardview.widget.CardView>

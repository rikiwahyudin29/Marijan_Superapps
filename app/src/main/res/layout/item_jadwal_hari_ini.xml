<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="HardcodedText,ContentDescription,Autofill,UseCompoundDrawables"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        
        <!-- Green Accent Strip -->
        <View
            android:layout_width="6dp"
            android:layout_height="match_parent"
            android:background="#0D9488" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingVertical="16dp"
            android:paddingStart="10dp"
            android:paddingEnd="16dp"
            android:gravity="center_vertical">
            
            <!-- Time Section -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="4dp"
                android:gravity="center"
                android:layout_marginEnd="16dp">
                <TextView
                    android:id="@+id/tvJamMulai"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="07:30"
                    android:textColor="#1F2937"
                    android:textSize="15sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="s/d"
                    android:textColor="#9CA3AF"
                    android:textSize="10sp"
                    android:layout_marginVertical="2dp" />
                <TextView
                    android:id="@+id/tvJamSelesai"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="09:00"
                    android:textColor="#6B7280"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Details Section -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/tvMataPelajaran"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pemrograman Web"
                    android:textColor="#1F2937"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:src="@drawable/ic_modern_tugas"
                            app:tint="#6B7280"
                            android:layout_marginEnd="4dp" />
                        <TextView
                            android:id="@+id/tvRuang"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Ruang Kelas"
                            android:textColor="#6B7280"
                            android:textSize="12sp" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:src="@drawable/ic_modern_profile"
                            app:tint="#6B7280"
                            android:layout_marginEnd="4dp" />
                        <TextView
                            android:id="@+id/tvKelas"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="XI-RPL 1"
                            android:textColor="#6B7280"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>
                
                <!-- Jurnal Materi & Presensi (Visible if filled) -->
                <LinearLayout
                    android:id="@+id/llJurnalDetail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="8dp"
                    android:visibility="gone">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:src="@android:drawable/ic_menu_edit"
                            app:tint="#10B981"
                            android:layout_marginEnd="4dp" />
                        <TextView
                            android:id="@+id/tvJurnalMateri"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Materi: -"
                            android:textColor="#10B981"
                            android:textSize="12sp"
                            android:textStyle="italic" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="4dp">
                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:src="@android:drawable/ic_menu_myplaces"
                            app:tint="#10B981"
                            android:layout_marginEnd="4dp" />
                        <TextView
                            android:id="@+id/tvJurnalPresensi"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="H:0 I:0 S:0 A:0"
                            android:textColor="#10B981"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                        <androidx.cardview.widget.CardView
                            android:id="@+id/cvFotoPreview"
                            android:layout_width="48dp"
                            android:layout_height="36dp"
                            app:cardCornerRadius="4dp"
                            app:cardElevation="0dp"
                            android:visibility="gone">
                            <ImageView
                                android:id="@+id/ivFotoPreview"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="centerCrop"
                                android:src="@android:color/darker_gray" />
                        </androidx.cardview.widget.CardView>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Play Button -->
            <ImageView
                android:id="@+id/ivAction"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@android:drawable/ic_media_play"
                android:background="@drawable/bg_icon_circle"
                android:backgroundTint="#F1F5F9"
                app:tint="#4F46E5"
                android:padding="6dp" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>

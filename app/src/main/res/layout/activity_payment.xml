<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <LinearLayout
        android:id="@+id/headerPayment"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:background="#00796B"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp">
        <ImageView
            android:id="@+id/btnBackPayment"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_back_circle"
            android:background="?attr/selectableItemBackgroundBorderless"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pembayaran Tripay"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginStart="16dp"/>
    </LinearLayout>

    <WebView
        android:id="@+id/webViewPayment"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/headerPayment" />

    <ProgressBar
        android:id="@+id/progressBarPayment"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true" />

</RelativeLayout>
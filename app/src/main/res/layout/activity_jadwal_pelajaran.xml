<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC">

    <!-- AppBar / Toolbar (Standar Screen Guru & Siswa) -->
    <include
        android:id="@+id/layoutTopBar"
        layout="@layout/layout_header_subactivity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="40dp"
        app:layout_constraintTop_toBottomOf="@id/layoutTopBar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Banner Info Kelas (Hero Style) -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardInfoKelas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_hero_jadwal_vibrant"
                    android:padding="18dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp">

                        <TextView
                            android:id="@+id/tvBadgeKelas"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_pill_translucent"
                            android:textColor="#FFFFFF"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="4dp"
                            android:text="● Kelas Memuat..."
                            android:layout_alignParentStart="true" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_pill_translucent"
                            android:textColor="#E0E7FF"
                            android:textSize="11sp"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="4dp"
                            android:text="TA 2026/2027"
                            android:layout_alignParentEnd="true" />
                    </RelativeLayout>

                    <TextView
                        android:id="@+id/tvJudulJadwalSekolah"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Jadwal KBM SMKS Riyadhul Jannah"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/tvWaliKelasJadwal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Wali Kelas : Memuat..."
                        android:textColor="#C7D2FE"
                        android:textSize="12sp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Day Selector Tabs (Horizontal Scroll) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pilih Hari KBM"
                android:textColor="#1E1B4B"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <HorizontalScrollView
                android:id="@+id/scrollDays"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:id="@+id/layoutDayChips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Senin -->
                    <TextView
                        android:id="@+id/chipSenin"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_chip_day_inactive"
                        android:textColor="#64748B"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:paddingHorizontal="18dp"
                        android:paddingVertical="10dp"
                        android:text="Senin"
                        android:clickable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:layout_marginEnd="8dp" />

                    <!-- Selasa -->
                    <TextView
                        android:id="@+id/chipSelasa"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_chip_day_inactive"
                        android:textColor="#64748B"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:paddingHorizontal="18dp"
                        android:paddingVertical="10dp"
                        android:text="Selasa"
                        android:clickable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:layout_marginEnd="8dp" />

                    <!-- Rabu -->
                    <TextView
                        android:id="@+id/chipRabu"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_chip_day_inactive"
                        android:textColor="#64748B"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:paddingHorizontal="18dp"
                        android:paddingVertical="10dp"
                        android:text="Rabu"
                        android:clickable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:layout_marginEnd="8dp" />

                    <!-- Kamis -->
                    <TextView
                        android:id="@+id/chipKamis"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_chip_day_inactive"
                        android:textColor="#64748B"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:paddingHorizontal="18dp"
                        android:paddingVertical="10dp"
                        android:text="Kamis"
                        android:clickable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:layout_marginEnd="8dp" />

                    <!-- Jumat -->
                    <TextView
                        android:id="@+id/chipJumat"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_chip_day_inactive"
                        android:textColor="#64748B"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:paddingHorizontal="18dp"
                        android:paddingVertical="10dp"
                        android:text="Jumat"
                        android:clickable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:layout_marginEnd="8dp" />

                    <!-- Sabtu -->
                    <TextView
                        android:id="@+id/chipSabtu"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_chip_day_inactive"
                        android:textColor="#64748B"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:paddingHorizontal="18dp"
                        android:paddingVertical="10dp"
                        android:text="Sabtu"
                        android:clickable="true"
                        android:foreground="?attr/selectableItemBackground" />
                </LinearLayout>
            </HorizontalScrollView>

            <!-- Loading Indicator -->
            <ProgressBar
                android:id="@+id/pbLoading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginVertical="30dp"
                android:visibility="gone" />

            <!-- Empty State -->
            <LinearLayout
                android:id="@+id/layoutEmptyState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="30dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:src="@drawable/ic_modern_jadwal"
                    app:tint="#CBD5E1"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:id="@+id/tvEmptyTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tidak Ada Jadwal Pelajaran"
                    android:textColor="#64748B"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tvEmptySubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hari libur atau belum ada jadwal KBM pada hari yang dipilih."
                    android:textColor="#94A3B8"
                    android:textSize="12sp"
                    android:textAlignment="center" />
            </LinearLayout>

            <!-- Container List Kartu Jadwal Pelajaran -->
            <LinearLayout
                android:id="@+id/containerJadwalHari"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>

<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    app:cardCornerRadius="18dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="#FFFFFF"
    app:strokeWidth="1dp"
    app:strokeColor="#E2E8F0">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Section: Icon, Title, Subtitle, Status Badge & Nominal -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Red Document Icon Container -->
            <RelativeLayout
                android:id="@+id/boxIconTagihan"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_badge_red_soft"
                android:gravity="center"
                android:layout_alignParentStart="true"
                android:layout_alignParentTop="true">
                <ImageView
                    android:id="@+id/ivIconTagihan"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_document_bill"/>
            </RelativeLayout>

            <!-- Right: Nominal Tagihan -->
            <LinearLayout
                android:id="@+id/layoutNominalRight"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_alignParentTop="true"
                android:gravity="end"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="NOMINAL"
                    android:textSize="9sp"
                    android:textColor="#64748B"
                    android:textStyle="bold"
                    android:letterSpacing="0.05"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TAGIHAN"
                    android:textSize="9sp"
                    android:textColor="#64748B"
                    android:textStyle="bold"
                    android:letterSpacing="0.05"
                    android:layout_marginBottom="2dp"/>
                <TextView
                    android:id="@+id/tvNominalTagihan"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Rp 0"
                    android:textColor="#0F172A"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-black"/>
            </LinearLayout>

            <!-- Middle: Pos Name, Subtitle, Badge -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@id/boxIconTagihan"
                android:layout_toStartOf="@id/layoutNominalRight"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvNamaTagihan"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tagihan Lainnya"
                    android:textColor="#0F172A"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:maxLines="2"
                    android:ellipsize="end"/>

                <TextView
                    android:id="@+id/tvKeteranganTagihan"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bulan ke- - | Keterangan: -"
                    android:textColor="#64748B"
                    android:textSize="11sp"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="6dp"
                    android:maxLines="2"
                    android:ellipsize="end"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tvBadgeStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="BELUM"
                        android:textColor="#DC2626"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="3dp"
                        android:background="@drawable/bg_badge_red_soft"/>

                    <TextView
                        android:id="@+id/tvBadgeTahunAjaran"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TA 2026/2027"
                        android:textColor="#4F46E5"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:layout_marginStart="6dp"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="3dp"
                        android:background="@drawable/bg_badge_blue_soft"/>
                </LinearLayout>
            </LinearLayout>
        </RelativeLayout>

        <!-- Divider Line -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#F1F5F9"
            android:layout_marginVertical="12dp"/>

        <!-- Bottom Row: Dibayar & Sisa | Button Bayar via QRIS -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">

            <LinearLayout
                android:id="@+id/layoutSisaRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:layout_toStartOf="@id/btnBayarTagihan"
                android:layout_marginEnd="10dp"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/tvDibayarTagihan"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Dibayar: Rp 0"
                    android:textColor="#10B981"
                    android:textSize="11sp"
                    android:textStyle="bold"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" | "
                    android:textColor="#CBD5E1"
                    android:textSize="11sp"/>
                <TextView
                    android:id="@+id/tvSisaTagihan"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sisa: Rp 0"
                    android:textColor="#DC2626"
                    android:textSize="11sp"
                    android:textStyle="bold"/>
            </LinearLayout>

            <!-- Bayar via QRIS Button -->
            <LinearLayout
                android:id="@+id/btnBayarTagihan"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_btn_bayar_qris"
                android:paddingHorizontal="14dp"
                android:gravity="center"
                android:orientation="horizontal"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_modern_scan"
                    app:tint="#FFFFFF"
                    android:layout_marginEnd="6dp"/>
                <TextView
                    android:id="@+id/tvTextBayarBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bayar via QRIS"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold"/>
            </LinearLayout>
        </RelativeLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>
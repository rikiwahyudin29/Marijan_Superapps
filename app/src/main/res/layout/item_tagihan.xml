<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="#FFFFFF"
    app:strokeWidth="1dp"
    app:strokeColor="#E5E7EB"> <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:id="@+id/tvKategoriTagihan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PEMBAYARAN PKL"
            android:textSize="11sp"
            android:textColor="#3B82F6"
            android:textStyle="bold"
            android:textAllCaps="true"/>

        <TextView
            android:id="@+id/tvBadgeStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:text="BELUM LUNAS"
            android:textSize="10sp"
            android:textColor="#DC2626"
            android:textStyle="bold"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:background="#FEE2E2" /> </RelativeLayout>

    <TextView
        android:id="@+id/tvNamaTagihan"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Pembayaran PKL"
        android:textSize="16sp"
        android:textColor="#111827"
        android:textStyle="bold"
        android:layout_marginTop="4dp"/>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="20dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sisa Bayar"
            android:textSize="14sp"
            android:textColor="#6B7280"/>
        <TextView
            android:id="@+id/tvNominalTagihan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:text="Rp 500.000"
            android:textSize="16sp"
            android:textColor="#111827"
            android:textStyle="bold"/>
    </RelativeLayout>

    <Button
        android:id="@+id/btnBayarTagihan"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="Bayar Online →"
        android:textAllCaps="false"
        android:textSize="15sp"
        android:textStyle="bold"
        android:backgroundTint="#1F2937"
        android:textColor="#FFFFFF"
        app:cornerRadius="12dp"/>
</LinearLayout>
</androidx.cardview.widget.CardView>
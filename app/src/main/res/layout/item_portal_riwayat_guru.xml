<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_rounded_border"
    android:backgroundTint="#F8FAFC"
    android:paddingHorizontal="12dp"
    android:paddingVertical="10dp"
    android:layout_marginBottom="8dp">

    <!-- Ikon Lingkaran Status -->
    <LinearLayout
        android:id="@+id/layoutRiwayatIconCircle"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:gravity="center"
        android:background="@drawable/bg_circle_green"
        android:backgroundTint="#DCFCE7">

        <ImageView
            android:id="@+id/ivRiwayatIcon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_check_circle_24"
            app:tint="#15803D" />
    </LinearLayout>

    <!-- Info Tanggal & Jam -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="6dp">

        <TextView
            android:id="@+id/tvRiwayatTanggal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Senin, 18 Ags 2026"
            android:textColor="#0F172A"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvRiwayatJam"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Masuk 06:48 WIB • Pulang --:-- WIB"
            android:textColor="#64748B"
            android:textSize="10sp"
            android:layout_marginTop="1dp" />
    </LinearLayout>

    <!-- Status Badge Pill -->
    <TextView
        android:id="@+id/tvRiwayatStatusBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Hadir Tepat Waktu"
        android:textColor="#15803D"
        android:textSize="9sp"
        android:textStyle="bold"
        android:background="@drawable/bg_rounded_border"
        android:backgroundTint="#DCFCE7"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp" />
</LinearLayout>

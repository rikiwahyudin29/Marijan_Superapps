<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="20dp"
    app:cardCornerRadius="24dp"
    app:cardElevation="10dp"
    app:cardBackgroundColor="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <!-- Top Header: Logo / School name & Close Button -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:layout_toStartOf="@id/btnCloseKartuPelajar"
                android:layout_marginEnd="8dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SMK RIYADHUL JANNAH"
                    android:textColor="#1E3A8A"
                    android:textSize="10.5sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.06"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Kartu Pelajar Digital"
                    android:textColor="#0F172A"
                    android:textSize="16.5sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-black"/>
            </LinearLayout>

            <ImageView
                android:id="@+id/btnCloseKartuPelajar"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:src="@drawable/ic_close_24"
                android:background="@drawable/bg_circle_gray"
                android:padding="6dp"
                app:tint="#64748B"/>
        </RelativeLayout>

        <!-- Card Body -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_rounded_border"
            android:backgroundTint="#F8FAFC"
            android:padding="16dp"
            android:gravity="center">

            <!-- Student Name -->
            <TextView
                android:id="@+id/tvKartuNamaSiswa"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nama Siswa"
                android:textColor="#0F172A"
                android:textSize="15.5sp"
                android:textStyle="bold"
                android:textAlignment="center"/>

            <!-- NISN & NIS -->
            <TextView
                android:id="@+id/tvKartuNisnNis"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NISN: - • NIS: -"
                android:textColor="#4338CA"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:layout_marginTop="2dp"/>

            <!-- Kelas & Jurusan -->
            <TextView
                android:id="@+id/tvKartuKelasJurusan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Kelas • Jurusan"
                android:textColor="#64748B"
                android:textSize="11sp"
                android:textAlignment="center"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="14dp"/>

            <!-- QR Code Container -->
            <FrameLayout
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:background="@drawable/bg_rounded_border"
                android:backgroundTint="#FFFFFF"
                android:padding="10dp">

                <ImageView
                    android:id="@+id/ivKartuQrCode"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitCenter"/>
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="● QR Code Resmi Terverifikasi"
                android:textColor="#059669"
                android:textSize="10sp"
                android:textStyle="bold"
                android:layout_marginTop="10dp"/>
        </LinearLayout>

        <!-- Information details -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="12dp">

            <TextView
                android:id="@+id/tvKartuWaliKelas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Wali Kelas: -"
                android:textColor="#475569"
                android:textSize="11sp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Status: Siswa Aktif Terdaftar TA 2026/2027"
                android:textColor="#64748B"
                android:textSize="10.5sp"
                android:layout_marginTop="2dp"/>
        </LinearLayout>

        <!-- Close Button -->
        <TextView
            android:id="@+id/btnTutupKartuPelajar"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="16dp"
            android:text="Tutup"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:gravity="center"
            android:background="@drawable/bg_rounded_border"
            android:backgroundTint="#1E1B4B"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"/>
    </LinearLayout>
</androidx.cardview.widget.CardView>

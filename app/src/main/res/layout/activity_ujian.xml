<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:filterTouchesWhenObscured="true">

    <!-- MAIN CONTENT ROOT -->
    <RelativeLayout
        android:id="@+id/rootUjianLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFFFFF"
        android:filterTouchesWhenObscured="true"
        android:fitsSystemWindows="true">

        <!-- ==================================================== -->
        <!-- 1. MAIN HEADER BAR (LOGO, TITLES, CAPSULE TIMER)     -->
        <!-- ==================================================== -->
        <LinearLayout
            android:id="@+id/headerUjianBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:background="#FFFFFF"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp">

            <!-- Logo MA RJ with Squircle Border -->
            <FrameLayout
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_logo_squircle"
                android:padding="3dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitCenter"
                    android:src="@drawable/logo_marj" />
            </FrameLayout>

            <!-- Titles: School name, Exam title, Mapel -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvInstansiHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="MA Riyadhul Jannah"
                    android:textColor="#0D9488"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvJudulUjianHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Ujian Berlangsung"
                    android:textColor="#1E1B4B"
                    android:textSize="15.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSubJudulUjian"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Konfigurasi Perangkat Jaringan..."
                    android:textColor="#64748B"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Capsule Timer (Pill) on Top Right -->
            <LinearLayout
                android:id="@+id/layoutTopTimerPill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_timer_pill"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="10dp"
                android:paddingVertical="6dp">

                <ImageView
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:src="@drawable/ic_clock_circle_24"
                    app:tint="#1E1B4B" />

                <TextView
                    android:id="@+id/tvTimer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="01:27:24"
                    android:textColor="#1E1B4B"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Garis Aksen Biru Tipis -->
        <View
            android:id="@+id/lineHeaderDivider"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_below="@id/headerUjianBar"
            android:background="#0284C7" />

        <!-- ==================================================== -->
        <!-- 2. STATUS DASHBOARD (JAM, KONEKSI, BATERAI, SISA)    -->
        <!-- ==================================================== -->
        <LinearLayout
            android:id="@+id/layoutStatusDashboard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/lineHeaderDivider"
            android:layout_marginHorizontal="12dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="6dp"
            android:background="@drawable/bg_cbt_status_container"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="6dp">

            <!-- Card 1: JAM -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="2dp"
                android:layout_weight="1"
                android:background="@drawable/bg_cbt_status_mini_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="6dp"
                android:paddingVertical="5dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_clock_circle_24"
                    app:tint="#4F46E5" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="JAM"
                        android:textColor="#64748B"
                        android:textSize="8sp"
                        android:textStyle="bold" />

                    <TextClock
                        android:id="@+id/tvClockStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:format12Hour="hh:mm"
                        android:format24Hour="HH:mm"
                        android:textColor="#0F172A"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Card 2: KONEKSI -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="2dp"
                android:layout_weight="1"
                android:background="@drawable/bg_cbt_status_mini_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="6dp"
                android:paddingVertical="5dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_wifi_24"
                    app:tint="#0284C7" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="KONEKSI"
                        android:textColor="#64748B"
                        android:textSize="8sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvSignalStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Stabil"
                        android:textColor="#0D9488"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Card 3: BATERAI -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="2dp"
                android:layout_weight="1"
                android:background="@drawable/bg_cbt_status_mini_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="6dp"
                android:paddingVertical="5dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_battery_std_24"
                    app:tint="#0D9488" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="BATERAI"
                        android:textColor="#64748B"
                        android:textSize="8sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvBatteryInfo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="100%"
                        android:textColor="#0F172A"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Card 4: SISA WAKTU (Soft Blue Card) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="2dp"
                android:layout_weight="1"
                android:background="@drawable/bg_cbt_status_sisa_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="6dp"
                android:paddingVertical="5dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_hourglass_24"
                    app:tint="#1E1B4B" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SISA"
                        android:textColor="#1E1B4B"
                        android:textSize="8sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvSisaMenit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="88 Menit"
                        android:textColor="#1E1B4B"
                        android:textSize="10.5sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- ==================================================== -->
        <!-- 3. SUB-HEADER BAR (NOMOR SOAL, ZOOM, DAFTAR)         -->
        <!-- ==================================================== -->
        <LinearLayout
            android:id="@+id/subHeaderBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/layoutStatusDashboard"
            android:background="#FFFFFF"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp"
            android:paddingVertical="6dp">

            <!-- Nomor Soal Badge (Stacked: SOAL KE / - 1) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_soal_navy"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp">

                <ImageView
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:src="@drawable/ic_document_bill"
                    app:tint="#FFFFFF" />

                <TextView
                    android:id="@+id/tvNomorSoal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:lineSpacingExtra="0dp"
                    android:text="SOAL KE\n- 1"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvTotalSoalLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:lineSpacingExtra="0dp"
                android:text="dari 40\nSoal"
                android:textColor="#64748B"
                android:textSize="11.5sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Font Size Controls (A- / A+) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:background="@drawable/bg_capsule_gray"
                android:clipToOutline="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="4dp">

                <TextView
                    android:id="@+id/btnZoomOut"
                    android:layout_width="32dp"
                    android:layout_height="match_parent"
                    android:clickable="true"
                    android:focusable="true"
                    android:clipToOutline="true"
                    android:foreground="@drawable/ripple_rounded_14dp"
                    android:gravity="center"
                    android:text="A-"
                    android:textColor="#334155"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="16dp"
                    android:background="#CBD5E1" />

                <TextView
                    android:id="@+id/btnZoomIn"
                    android:layout_width="32dp"
                    android:layout_height="match_parent"
                    android:clickable="true"
                    android:focusable="true"
                    android:clipToOutline="true"
                    android:foreground="@drawable/ripple_rounded_14dp"
                    android:gravity="center"
                    android:text="A+"
                    android:textColor="#334155"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Tombol Daftar Soal (Grid) -->
            <LinearLayout
                android:id="@+id/btnGridNavigasi"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_capsule_gray"
                android:clickable="true"
                android:focusable="true"
                android:clipToOutline="true"
                android:foreground="@drawable/ripple_rounded_pill"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="10dp">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_grid_view_24"
                    app:tint="#334155" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Daftar"
                    android:textColor="#334155"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- ==================================================== -->
        <!-- 4. FOOTER STATUS (AUTOSAVE JAWABAN TERSIMPAN)        -->
        <!-- ==================================================== -->
        <LinearLayout
            android:id="@+id/layoutAutosaveStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_above="@id/footerUjian"
            android:background="#FFFFFF"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="6dp">

            <View
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:background="@drawable/bg_circle_green" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="Jawaban otomatis tersimpan"
                android:textColor="#059669"
                android:textSize="11sp"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvSessionId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ID Sesi: CBT-ONLINE"
                android:textColor="#94A3B8"
                android:textSize="10sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- ==================================================== -->
        <!-- 5. BOTTOM ACTION NAVIGATION BAR                      -->
        <!-- ==================================================== -->
        <LinearLayout
            android:id="@+id/footerUjian"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:background="#FFFFFF"
            android:elevation="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="14dp">

            <!-- Tombol Sebelumnya -->
            <FrameLayout
                android:id="@+id/btnPrev"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_capsule_gray"
                android:clipToOutline="true"
                android:clickable="true"
                android:focusable="true"
                android:foreground="@drawable/ripple_rounded_pill">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_skip_previous_24"
                    app:tint="#94A3B8" />
            </FrameLayout>

            <!-- Tombol Ragu-ragu -->
            <LinearLayout
                android:id="@+id/layoutRaguContainer"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                android:background="@drawable/bg_btn_ragu_amber"
                android:clipToOutline="true"
                android:clickable="true"
                android:focusable="true"
                android:foreground="@drawable/ripple_rounded_pill"
                android:gravity="center"
                android:orientation="horizontal">

                <CheckBox
                    android:id="@+id/cbRaguRagu"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:buttonTint="#D97706"
                    android:text="Ragu-ragu"
                    android:textColor="#B45309"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Tombol Lanjut -->
            <FrameLayout
                android:id="@+id/btnNext"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:background="@drawable/bg_btn_lanjut_navy"
                android:clipToOutline="true"
                android:clickable="true"
                android:focusable="true"
                android:foreground="@drawable/ripple_rounded_white_pill"
                android:minWidth="110dp"
                android:paddingHorizontal="18dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Lanjut"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginStart="6dp"
                        android:src="@drawable/ic_skip_next_24"
                        app:tint="#FFFFFF" />
                </LinearLayout>
            </FrameLayout>

            <!-- Tombol Selesai Ujian -->
            <FrameLayout
                android:id="@+id/btnSelesai"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:background="@drawable/bg_btn_success"
                android:clipToOutline="true"
                android:clickable="true"
                android:focusable="true"
                android:foreground="@drawable/ripple_rounded_white_pill"
                android:minWidth="120dp"
                android:paddingHorizontal="18dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvBtnSelesaiText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Selesai Ujian"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginStart="6dp"
                        android:src="@drawable/ic_check_circle_24"
                        app:tint="#FFFFFF" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>

        <!-- ==================================================== -->
        <!-- 6. SCROLLABLE SOAL AREA DENGAN WATERMARK             -->
        <!-- ==================================================== -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@id/layoutAutosaveStatus"
            android:layout_below="@id/subHeaderBar">

            <!-- WATERMARK KEAMANAN TRANSPARAN -->
            <TextView
                android:id="@+id/tvSecurityWatermark"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:alpha="0.06"
                android:gravity="center"
                android:rotation="-25"
                android:text="MA RIYADHUL JANNAH • CBT SECURITY"
                android:textColor="#000000"
                android:textSize="19sp"
                android:textStyle="bold" />

            <androidx.core.widget.NestedScrollView
                android:id="@+id/scrollSoalContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:fillViewport="true"
                android:paddingHorizontal="14dp"
                android:paddingTop="10dp"
                android:paddingBottom="20dp">

                <!-- Outer Card Rounded Container for Question & Options -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_cbt_status_container"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Gambar Soal Atas (Jika ada) -->
                    <ImageView
                        android:id="@+id/ivSoalAtas"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:adjustViewBounds="true"
                        android:visibility="gone" />

                    <!-- Teks Pertanyaan Soal -->
                    <TextView
                        android:id="@+id/tvTeksSoal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="18dp"
                        android:lineSpacingExtra="5dp"
                        android:text="Memuat butir pertanyaan..."
                        android:textColor="#0F172A"
                        android:textIsSelectable="false"
                        android:textSize="15sp" />

                    <!-- Wadah Opsi Jawaban (PG, PGK, Esai, Menjodohkan) -->
                    <LinearLayout
                        android:id="@+id/wadahJawaban"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>
        </FrameLayout>
    </RelativeLayout>

    <!-- ==================================================== -->
    <!-- 7. DRAWER PANEL NAVIGASI SOAL                        -->
    <!-- ==================================================== -->
    <LinearLayout
        android:layout_width="320dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="#FFFFFF"
        android:elevation="16dp"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_grid_view_24"
                app:tint="#1E1B4B" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="Daftar Nomor Soal"
                android:textColor="#0F172A"
                android:textSize="18sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/btnCloseDrawer"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_close_24"
                app:tint="#64748B" />
        </LinearLayout>

        <!-- Keterangan Legend Warna -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_capsule_gray"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp"
            android:paddingVertical="8dp">

            <!-- Legend 1: Terjawab -->
            <View
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="@drawable/bg_badge_soal_navy" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="Dijawab"
                android:textColor="#334155"
                android:textSize="11sp" />

            <!-- Legend 2: Ragu -->
            <View
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/bg_circle_yellow" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="Ragu"
                android:textColor="#334155"
                android:textSize="11sp" />

            <!-- Legend 3: Belum -->
            <View
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/bg_circle_gray" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="Kosong"
                android:textColor="#334155"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Grid Nomor Soal -->
        <GridView
            android:id="@+id/gridNavigasi"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:horizontalSpacing="12dp"
            android:numColumns="5"
            android:verticalSpacing="12dp" />
    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>
<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="HardcodedText,ContentDescription,Autofill"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:paddingBottom="100dp"
    android:background="@android:color/transparent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">
        <!-- Mata Pelajaran Diampu Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cvMapelDiampu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:background="#FFFFFF">
                
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="MATA PELAJARAN\nDIAMPU"
                        android:textColor="#1E3A8A"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/tvTotalJamMapelHeader"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Total: 0\nJam/Minggu"
                        android:textColor="#2563EB"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:gravity="end" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/containerMapelDiampu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <!-- Items will be injected here dynamically -->
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Top Metrics Cards -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp">
            
            <!-- Jam Minggu Ini -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:background="#FFFFFF">
                    <ImageView
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:src="@drawable/ic_modern_clock"
                        android:background="@drawable/bg_icon_circle"
                        android:backgroundTint="#EFF6FF"
                        app:tint="#2563EB"
                        android:padding="8dp"
                        android:layout_marginBottom="12dp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Total Jam Minggu Ini"
                        android:textColor="#64748B"
                        android:textSize="12sp"
                        android:layout_marginBottom="8dp"/>
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="bottom">
                        <TextView
                            android:id="@+id/tvTotalJamMingguIni"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="#1E40AF"
                            android:textSize="26sp"
                            android:textStyle="bold"
                            android:layout_marginEnd="4dp"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Jam"
                            android:textColor="#3B82F6"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="2dp"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Siswa Belum Absen -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:background="#FFFFFF">
                    <ImageView
                        android:id="@+id/ivSiswaBelumAbsenIcon"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:src="@drawable/ic_modern_profile"
                        android:background="@drawable/bg_icon_circle"
                        android:backgroundTint="#ECFDF5"
                        app:tint="#10B981"
                        android:padding="8dp"
                        android:layout_marginBottom="12dp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Siswa Belum Absen"
                        android:textColor="#64748B"
                        android:textSize="12sp"
                        android:layout_marginBottom="8dp"/>
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="bottom">
                        <TextView
                            android:id="@+id/tvSiswaBelumAbsen"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="#059669"
                            android:textSize="26sp"
                            android:textStyle="bold"
                            android:layout_marginEnd="4dp"/>
                        <TextView
                            android:id="@+id/tvLabelSiswaBelumAbsen"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Siswa"
                            android:textColor="#10B981"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="2dp"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Aksi Cepat"
            android:textColor="#1E3A8A"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <!-- Quick Actions Container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="24dp">

            <!-- Baris 1: Jurnal Mengajar & Rekap Mengajar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <!-- Card Jurnal Mengajar -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/btnJurnalMengajar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="145dp"
                        android:background="#FFFFFF"
                        android:orientation="vertical"
                        android:padding="14dp"
                        android:gravity="center">
                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:src="@drawable/ic_modern_tugas"
                            android:background="@drawable/bg_icon_circle"
                            android:backgroundTint="#EEF2FF"
                            app:tint="#4F46E5"
                            android:padding="12dp"
                            android:layout_marginBottom="8dp"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Isi Jurnal Aktif"
                            android:textColor="#0F172A"
                            android:textSize="13sp"
                            android:textAlignment="center"
                            android:gravity="center"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Sedang Berlangsung"
                            android:textColor="#4F46E5"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:layout_marginTop="4dp"
                            android:background="@drawable/bg_rounded_border"
                            android:backgroundTint="#EEF2FF"
                            android:paddingHorizontal="7dp"
                            android:paddingVertical="2.5dp"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Card Rekap Mengajar -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/btnRekapMengajar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="145dp"
                        android:background="#FFFFFF"
                        android:orientation="vertical"
                        android:padding="14dp"
                        android:gravity="center">
                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:src="@drawable/ic_modern_materi"
                            android:background="@drawable/bg_icon_circle"
                            android:backgroundTint="#F5F3FF"
                            app:tint="#7C3AED"
                            android:padding="12dp"
                            android:layout_marginBottom="8dp"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Rekap Mengajar"
                            android:textColor="#0F172A"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Riwayat &amp; Presensi"
                            android:textColor="#7C3AED"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:layout_marginTop="4dp"
                            android:background="@drawable/bg_rounded_border"
                            android:backgroundTint="#F5F3FF"
                            android:paddingHorizontal="7dp"
                            android:paddingVertical="2.5dp" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <!-- Baris 2: Card Jadwal Mengajar Full Width -->
            <androidx.cardview.widget.CardView
                android:id="@+id/btnJadwalMengajar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#FFFFFF"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:gravity="center_vertical">
                    <ImageView
                        android:layout_width="46dp"
                        android:layout_height="46dp"
                        android:src="@drawable/ic_modern_jadwal"
                        android:background="@drawable/bg_icon_circle"
                        android:backgroundTint="#E0F2FE"
                        app:tint="#0284C7"
                        android:padding="11dp"
                        android:layout_marginEnd="14dp"/>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Jadwal Mengajar"
                            android:textColor="#0F172A"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Lihat jadwal mingguan, ruang kelas &amp; matriks KBM"
                            android:textColor="#64748B"
                            android:textSize="11sp"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>
                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="#0284C7" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <!-- Section Menu Wali Kelas (Hanya muncul jika guru adalah Wali Kelas) -->
        <LinearLayout
            android:id="@+id/sectionWaliKelas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginBottom="24dp">

            <!-- Header Section Wali Kelas -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Menu Wali Kelas"
                    android:textColor="#1E3A8A"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <!-- Badge Keterangan Kelas Binaan -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_rounded_border"
                    android:backgroundTint="#EEF2FF"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="5dp">
                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/ic_modern_profile"
                        app:tint="#4338CA"
                        android:layout_marginEnd="6dp"/>
                    <TextView
                        android:id="@+id/tvWaliKelasBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Kelas: -"
                        android:textColor="#4338CA"
                        android:textSize="11sp"
                        android:textStyle="bold"/>
                </LinearLayout>
            </LinearLayout>

            <!-- 3 Tombol Card Wali Kelas (Sesuai Desain Dashboard Akademik) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- 1. Card Absen Harian -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/btnWaliAbsenHarian"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="5dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="145dp"
                        android:background="#FFFFFF"
                        android:orientation="vertical"
                        android:padding="10dp"
                        android:gravity="center">
                        <ImageView
                            android:layout_width="46dp"
                            android:layout_height="46dp"
                            android:src="@drawable/ic_modern_presensi"
                            android:background="@drawable/bg_icon_circle"
                            android:backgroundTint="#FFE4E6"
                            app:tint="#E11D48"
                            android:padding="11dp"
                            android:layout_marginBottom="8dp"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Absen Harian"
                            android:textColor="#0F172A"
                            android:textSize="12sp"
                            android:gravity="center"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Input Absensi"
                            android:textColor="#E11D48"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:layout_marginTop="4dp"
                            android:background="@drawable/bg_rounded_border"
                            android:backgroundTint="#FFE4E6"
                            android:paddingHorizontal="6dp"
                            android:paddingVertical="2dp"
                            android:gravity="center" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- 2. Card Rekap Kehadiran -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/btnWaliRekapKehadiran"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="2.5dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="145dp"
                        android:background="#FFFFFF"
                        android:orientation="vertical"
                        android:padding="10dp"
                        android:gravity="center">
                        <ImageView
                            android:layout_width="46dp"
                            android:layout_height="46dp"
                            android:src="@drawable/ic_modern_tugas"
                            android:background="@drawable/bg_icon_circle"
                            android:backgroundTint="#FEF3C7"
                            app:tint="#D97706"
                            android:padding="11dp"
                            android:layout_marginBottom="8dp"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Rekap Kehadiran"
                            android:textColor="#0F172A"
                            android:textSize="12sp"
                            android:gravity="center"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Presensi Siswa"
                            android:textColor="#D97706"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:layout_marginTop="4dp"
                            android:background="@drawable/bg_rounded_border"
                            android:backgroundTint="#FEF3C7"
                            android:paddingHorizontal="6dp"
                            android:paddingVertical="2dp"
                            android:gravity="center" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- 3. Card Keuangan Kelas -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/btnWaliKeuanganKelas"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="5dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="145dp"
                        android:background="#FFFFFF"
                        android:orientation="vertical"
                        android:padding="10dp"
                        android:gravity="center">
                        <ImageView
                            android:layout_width="46dp"
                            android:layout_height="46dp"
                            android:src="@drawable/ic_modern_keuangan"
                            android:background="@drawable/bg_icon_circle"
                            android:backgroundTint="#DCFCE7"
                            app:tint="#16A34A"
                            android:padding="11dp"
                            android:layout_marginBottom="8dp"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Keuangan Kelas"
                            android:textColor="#0F172A"
                            android:textSize="12sp"
                            android:gravity="center"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tagihan Siswa"
                            android:textColor="#16A34A"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:layout_marginTop="4dp"
                            android:background="@drawable/bg_rounded_border"
                            android:backgroundTint="#DCFCE7"
                            android:paddingHorizontal="6dp"
                            android:paddingVertical="2dp"
                            android:gravity="center" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

            </LinearLayout>
        </LinearLayout>

        <!-- Jadwal Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Jadwal Mengajar Hari Ini"
                android:textColor="#1E3A8A"
                android:textSize="16sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/btnLihatSemuaJadwal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Lihat Semua"
                android:textColor="#0284C7"
                android:textSize="12sp"
                android:textStyle="bold"
                android:padding="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"/>
        </LinearLayout>

        <!-- Dynamic Container for Jadwal Items -->
        <LinearLayout
            android:id="@+id/containerJadwalHariIni"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <!-- Items will be injected here dynamically via code -->
            
            <!-- Loading Indicator -->
            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/pbJadwal"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_gravity="center"
                android:layout_margin="20dp"
                app:lottie_url="https://lottie.host/ff71b2dd-787e-4f88-9f79-79f0eb2c8641/OqV9rU5oMu.json"
                app:lottie_autoPlay="true"
                app:lottie_loop="true" />
                
            <TextView
                android:id="@+id/tvEmptyJadwal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tidak ada jadwal hari ini"
                android:gravity="center"
                android:textColor="#6B7280"
                android:layout_margin="20dp"
                android:visibility="gone"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>

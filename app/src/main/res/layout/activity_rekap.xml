<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootRekap"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_animated_gradient">

    <LinearLayout
        android:id="@+id/titleLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="12dp"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/btnBackRekap"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_back_circle"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Riwayat Kehadiran"
            android:textColor="#1E3A8A"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginStart="20dp" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="24dp"
        app:layout_constraintTop_toBottomOf="@id/titleLayout"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp">

            <!-- Month Selector Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:background="#FFFFFF"
                    android:gravity="center">

                    <androidx.cardview.widget.CardView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        app:cardCornerRadius="18dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="#F1F5F9">
                        <ImageView
                            android:id="@+id/btnPrevMonth"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/ic_baseline_arrow_back_24"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:padding="8dp"
                            app:tint="#1E3A8A" />
                    </androidx.cardview.widget.CardView>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="horizontal">
                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_modern_presensi"
                            app:tint="#1E3A8A"
                            android:layout_marginEnd="8dp"/>
                        <TextView
                            android:id="@+id/tvMonthYear"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Oktober 2023"
                            android:textColor="#1E3A8A"
                            android:textStyle="bold"
                            android:textSize="16sp"/>
                    </LinearLayout>

                    <androidx.cardview.widget.CardView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        app:cardCornerRadius="18dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="#F1F5F9">
                        <ImageView
                            android:id="@+id/btnNextMonth"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/ic_baseline_arrow_back_24"
                            android:rotation="180"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:padding="8dp"
                            app:tint="#1E3A8A" />
                    </androidx.cardview.widget.CardView>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Calendar Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:background="#FFFFFF">

                    <!-- Days of Week Header -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="7"
                        android:layout_marginBottom="12dp">
                        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Min" android:gravity="center" android:textSize="12sp" android:textColor="#6B7280"/>
                        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Sen" android:gravity="center" android:textSize="12sp" android:textColor="#6B7280"/>
                        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Sel" android:gravity="center" android:textSize="12sp" android:textColor="#6B7280"/>
                        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Rab" android:gravity="center" android:textSize="12sp" android:textColor="#6B7280"/>
                        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Kam" android:gravity="center" android:textSize="12sp" android:textColor="#6B7280"/>
                        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Jum" android:gravity="center" android:textSize="12sp" android:textColor="#6B7280"/>
                        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Sab" android:gravity="center" android:textSize="12sp" android:textColor="#6B7280"/>
                    </LinearLayout>

                    <!-- Calendar Grid -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvCalendar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                        app:spanCount="7" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Stats Circles Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:background="#FFFFFF">

                    <!-- Baris 1: Hadir, Izin, Sakit, Alfa -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="4">

                        <!-- Hadir -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="vertical">
                            <TextView
                                android:id="@+id/tvTotalHadir"
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:text="0"
                                android:textColor="#FFFFFF"
                                android:textStyle="bold"
                                android:textSize="18sp"
                                android:gravity="center"
                                android:background="@drawable/bg_calendar_day_selected"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Hadir"
                                android:textSize="10sp"
                                android:textColor="#6B7280"
                                android:layout_marginTop="8dp"/>
                        </LinearLayout>

                        <!-- Izin -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="vertical">
                            <TextView
                                android:id="@+id/tvTotalIzin"
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:text="0"
                                android:textColor="#FFFFFF"
                                android:textStyle="bold"
                                android:textSize="18sp"
                                android:gravity="center"
                                android:background="@drawable/bg_icon_circle"
                                android:backgroundTint="#00D2D3"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Izin"
                                android:textSize="10sp"
                                android:textColor="#6B7280"
                                android:layout_marginTop="8dp"/>
                        </LinearLayout>

                        <!-- Sakit -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="vertical">
                            <TextView
                                android:id="@+id/tvTotalSakit"
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:text="0"
                                android:textColor="#4B5563"
                                android:textStyle="bold"
                                android:textSize="18sp"
                                android:gravity="center"
                                android:background="@drawable/bg_icon_circle"
                                android:backgroundTint="#E5E7EB"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Sakit"
                                android:textSize="10sp"
                                android:textColor="#6B7280"
                                android:layout_marginTop="8dp"/>
                        </LinearLayout>

                        <!-- Alfa -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="vertical">
                            <TextView
                                android:id="@+id/tvTotalAlpha"
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:text="0"
                                android:textColor="#991B1B"
                                android:textStyle="bold"
                                android:textSize="18sp"
                                android:gravity="center"
                                android:background="@drawable/bg_icon_circle"
                                android:backgroundTint="#FEE2E2"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Alfa"
                                android:textSize="10sp"
                                android:textColor="#6B7280"
                                android:layout_marginTop="8dp"/>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Baris 2: Telat, Cuti, DL -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="16dp"
                        android:weightSum="4">

                        <!-- Terlambat -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="vertical">
                            <TextView
                                android:id="@+id/tvTotalTerlambat"
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:text="0m"
                                android:textColor="#B45309"
                                android:textStyle="bold"
                                android:textSize="14sp"
                                android:gravity="center"
                                android:background="@drawable/bg_icon_circle"
                                android:backgroundTint="#FEF3C7"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Telat"
                                android:textSize="10sp"
                                android:textColor="#6B7280"
                                android:layout_marginTop="8dp"/>
                        </LinearLayout>
                        
                        <!-- Cuti -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="vertical">
                            <TextView
                                android:id="@+id/tvTotalCuti"
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:text="0"
                                android:textColor="#FFFFFF"
                                android:textStyle="bold"
                                android:textSize="18sp"
                                android:gravity="center"
                                android:background="@drawable/bg_icon_circle"
                                android:backgroundTint="#8B5CF6"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Cuti"
                                android:textSize="10sp"
                                android:textColor="#6B7280"
                                android:layout_marginTop="8dp"/>
                        </LinearLayout>

                        <!-- Dinas Luar -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="vertical">
                            <TextView
                                android:id="@+id/tvTotalDinasLuar"
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:text="0"
                                android:textColor="#FFFFFF"
                                android:textStyle="bold"
                                android:textSize="18sp"
                                android:gravity="center"
                                android:background="@drawable/bg_icon_circle"
                                android:backgroundTint="#0EA5E9"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="DL"
                                android:textSize="10sp"
                                android:textColor="#6B7280"
                                android:layout_marginTop="8dp"/>
                        </LinearLayout>

                        <!-- Spacer agar kotak seimbang posisinya -->
                        <View
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="1dp"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Detail Day Title -->
            <TextView
                android:id="@+id/tvDetailTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Detail Hari:"
                android:textColor="#1E3A8A"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <!-- Detail Day Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="#FFFFFF"
                    android:padding="20dp"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Masuk"
                            android:textColor="#6B7280"
                            android:textSize="12sp"
                            app:drawableStartCompat="@drawable/ic_modern_presensi"
                            app:drawableTint="#6B7280"
                            android:drawablePadding="4dp"/>
                        <TextView
                            android:id="@+id/tvDetailMasuk"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="--"
                            android:textColor="#1E3A8A"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:layout_marginTop="4dp"/>
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="#E5E7EB"
                        android:layout_marginHorizontal="16dp"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Pulang"
                            android:textColor="#6B7280"
                            android:textSize="12sp"
                            app:drawableStartCompat="@drawable/ic_modern_presensi"
                            app:drawableTint="#6B7280"
                            android:drawablePadding="4dp"/>
                        <TextView
                            android:id="@+id/tvDetailPulang"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="--"
                            android:textColor="#1A1B41"
                            android:textSize="16sp"
                            android:layout_marginTop="4dp"/>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvDetailStatusBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="-"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="8dp"
                        android:background="@drawable/bg_calendar_day_selected"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>


    
</androidx.constraintlayout.widget.ConstraintLayout>
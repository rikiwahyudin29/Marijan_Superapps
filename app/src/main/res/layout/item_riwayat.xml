<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="#FFFFFF"
    app:strokeWidth="1dp"
    app:strokeColor="#E5E7EB">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/tvTanggalRiwayat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="10 May 2026"
                android:textSize="12sp"
                android:textColor="#6B7280"/>

            <TextView
                android:id="@+id/tvBadgeRiwayat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="MENUNGGU"
                android:textSize="10sp"
                android:textColor="#D97706"
                android:textStyle="bold"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:background="#FEF3C7" />
        </RelativeLayout>

        <TextView
            android:id="@+id/tvNamaRiwayat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pembayaran PKL"
            android:textSize="15sp"
            android:textColor="#111827"
            android:textStyle="bold"/>
        <TextView
            android:id="@+id/tvMetodeRiwayat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="QRIS BY SHOPEEPAY"
            android:textSize="12sp"
            android:textColor="#6B7280"
            android:textAllCaps="true"
            android:layout_marginTop="2dp"/>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <TextView
                android:id="@+id/tvNominalRiwayat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:text="Rp 500.000"
                android:textSize="16sp"
                android:textColor="#111827"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/btnLanjutBayar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:text="Lanjut Bayar"
                android:textSize="13sp"
                android:textColor="#3B82F6"
                android:textStyle="bold"
                android:clickable="true"
                android:foreground="?attr/selectableItemBackground"
                android:visibility="gone"
                android:padding="8dp"/>
        </RelativeLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
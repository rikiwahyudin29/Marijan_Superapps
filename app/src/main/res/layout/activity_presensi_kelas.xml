<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_animated_gradient"
    tools:ignore="HardcodedText,Autofill,ContentDescription">

    <!-- Top App Bar -->
    <LinearLayout
        android:id="@+id/appBar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:layout_alignParentTop="true"
        android:background="@android:color/transparent"
        android:elevation="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_baseline_arrow_back_24"
            app:tint="#1E293B"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"/>

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="16dp"
            android:src="@drawable/logo_marj" />
            
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="8dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Marijan Superapps"
                android:textColor="#64748B"
                android:textSize="10sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Presensi Kelas"
                android:textColor="#1E293B"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Profile Pic -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cvProfilPic"
            android:layout_width="36dp"
            android:layout_height="36dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            android:clickable="true"
            android:foreground="?attr/selectableItemBackground">
            <ImageView
                android:id="@+id/ivProfilPhoto"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@android:drawable/ic_menu_myplaces"
                android:scaleType="centerCrop"/>
        </androidx.cardview.widget.CardView>
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/appBar"
        android:layout_above="@id/bottomBar"
        android:clipToPadding="false"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Session Info Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#1E1B4B"
                android:layout_marginBottom="16dp">
                
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">
                    
                    <!-- Filter Badges Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        
                        <TextView
                            android:id="@+id/tvKelasBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_rounded_border"
                            android:backgroundTint="#312E81"
                            android:text="KELAS"
                            android:textColor="#A5B4FC"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="4dp"
                            android:layout_marginEnd="8dp"/>
                            
                        <TextView
                            android:id="@+id/tvMapelBadge"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/bg_rounded_border"
                            android:backgroundTint="#312E81"
                            android:text="Mata Pelajaran"
                            android:textColor="#FFFFFF"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="4dp"
                            android:layout_marginEnd="8dp"/>
                            
                        <TextView
                            android:id="@+id/tvJamKeBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_rounded_border"
                            android:backgroundTint="#312E81"
                            android:text="Jam: -"
                            android:textColor="#A5B4FC"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="4dp"/>
                    </LinearLayout>
                    
                    <!-- Subject Topic Title & Total Card -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="16dp">
                        
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            
                            <TextView
                                android:id="@+id/tvMateri"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Materi Pelajaran"
                                android:textColor="#FFFFFF"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:maxLines="2"
                                android:ellipsize="end"/>
                                
                            <TextView
                                android:id="@+id/tvTanggal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Tanggal Hari Ini"
                                android:textColor="#A5B4FC"
                                android:textSize="12sp"
                                android:layout_marginTop="4dp"
                                android:drawablePadding="6dp"/>
                        </LinearLayout>
                        
                        <!-- Total Students Badge -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:background="@drawable/bg_rounded_border"
                            android:backgroundTint="#312E81"
                            android:paddingHorizontal="14dp"
                            android:paddingVertical="8dp"
                            android:gravity="center"
                            android:layout_marginStart="12dp">
                            
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="TOTAL SISWA"
                                android:textColor="#A5B4FC"
                                android:textSize="9sp"
                                android:textStyle="bold"/>
                                
                            <TextView
                                android:id="@+id/tvTotalSiswa"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textColor="#FFFFFF"
                                android:textSize="20sp"
                                android:textStyle="bold"/>
                        </LinearLayout>
                    </LinearLayout>
                    
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#20FFFFFF"
                        android:layout_marginTop="14dp"
                        android:layout_marginBottom="10dp"/>
                        
                    <!-- Realtime Attendance Summary Chips -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        
                        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="center_vertical">
                            <View android:layout_width="8dp" android:layout_height="8dp" android:background="@drawable/bg_circle_green" android:layout_marginEnd="4dp"/>
                            <TextView android:id="@+id/tvSummaryHadir" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0 Hadir" android:textColor="#F8FAFC" android:textSize="11sp"/>
                        </LinearLayout>
                        
                        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="center_vertical">
                            <View android:layout_width="8dp" android:layout_height="8dp" android:background="@drawable/bg_circle_yellow" android:layout_marginEnd="4dp"/>
                            <TextView android:id="@+id/tvSummarySakit" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0 Sakit" android:textColor="#F8FAFC" android:textSize="11sp"/>
                        </LinearLayout>
                        
                        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="center_vertical">
                            <View android:layout_width="8dp" android:layout_height="8dp" android:background="@drawable/bg_circle_yellow" android:layout_marginEnd="4dp"/>
                            <TextView android:id="@+id/tvSummaryIzin" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0 Izin" android:textColor="#F8FAFC" android:textSize="11sp"/>
                        </LinearLayout>
                        
                        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="center_vertical">
                            <View android:layout_width="8dp" android:layout_height="8dp" android:background="@drawable/bg_circle_red" android:layout_marginEnd="4dp"/>
                            <TextView android:id="@+id/tvSummaryAlpa" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0 Alpa" android:textColor="#F8FAFC" android:textSize="11sp"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            
            <!-- Quick Attendance Bulk Actions -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                android:layout_marginBottom="12dp">
                
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">
                    
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="SET KEHADIRAN SEMUA:"
                            android:textColor="#475569"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:layout_alignParentStart="true"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1 Tap Sekaligus"
                            android:textColor="#475569"
                            android:textSize="10sp"
                            android:layout_alignParentEnd="true"/>
                    </RelativeLayout>
                    
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <Button
                            android:id="@+id/btnSetHadir"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_weight="1"
                            android:text="Hadir"
                            android:textSize="11sp"
                            android:textColor="#047857"
                            android:backgroundTint="#ECFDF5"
                            app:strokeColor="#A7F3D0"
                            app:strokeWidth="1dp"
                            android:insetBottom="0dp"
                            android:insetTop="0dp"
                            android:layout_marginEnd="4dp"/>
                        <Button
                            android:id="@+id/btnSetSakit"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_weight="1"
                            android:text="Sakit"
                            android:textSize="11sp"
                            android:textColor="#047857"
                            android:backgroundTint="#ECFDF5"
                            app:strokeColor="#A7F3D0"
                            app:strokeWidth="1dp"
                            android:insetBottom="0dp"
                            android:insetTop="0dp"
                            android:layout_marginEnd="4dp"/>
                        <Button
                            android:id="@+id/btnSetIzin"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_weight="1"
                            android:text="Izin"
                            android:textSize="11sp"
                            android:textColor="#B45309"
                            android:backgroundTint="#FFFBEB"
                            app:strokeColor="#FDE68A"
                            app:strokeWidth="1dp"
                            android:insetBottom="0dp"
                            android:insetTop="0dp"
                            android:layout_marginEnd="4dp"/>
                        <Button
                            android:id="@+id/btnSetAlpa"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_weight="1"
                            android:text="Alpa"
                            android:textSize="11sp"
                            android:textColor="#BE123C"
                            android:backgroundTint="#FFF1F2"
                            app:strokeColor="#FECDD3"
                            app:strokeWidth="1dp"
                            android:insetBottom="0dp"
                            android:insetTop="0dp"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            
            <!-- Search Input -->
            <EditText
                android:id="@+id/etSearchSiswa"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_input_rounded"
                android:hint="Cari nama siswa atau NISN..."
                android:paddingHorizontal="16dp"
                android:drawableStart="@android:drawable/ic_menu_search"
                android:drawablePadding="8dp"
                android:textSize="12sp"
                android:layout_marginBottom="16dp"
                android:maxLines="1"
                android:inputType="text"/>
                
            <!-- Student List Header -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp">
                <TextView
                    android:id="@+id/tvTitleDaftarSiswa"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DAFTAR SISWA (0)"
                    android:textColor="#475569"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_alignParentStart="true"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Urut Nomor Absen"
                    android:textColor="#059669"
                    android:textSize="11sp"
                    android:layout_alignParentEnd="true"/>
            </RelativeLayout>
            
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvSiswa"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                tools:listitem="@layout/item_siswa_presensi"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Sticky Bar -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="#FFFFFF"
        android:orientation="vertical"
        android:padding="16dp"
        android:elevation="16dp">
        
        <!-- Progress Indicator -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">
            
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_alignParentStart="true">
                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@android:drawable/checkbox_on_background"
                    app:tint="#10B981"
                    android:layout_marginEnd="4dp"/>
                <TextView
                    android:id="@+id/tvProgressAbsen"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 dari 0 Siswa telah diabsen"
                    android:textColor="#1E293B"
                    android:textSize="12sp"
                    android:textStyle="bold"/>
            </LinearLayout>
            
            <TextView
                android:id="@+id/tvProgressBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0% Lengkap"
                android:textColor="#047857"
                android:background="@drawable/bg_badge_green_dark"
                android:textSize="10sp"
                android:textStyle="bold"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            
            <Button
                android:id="@+id/btnBatal"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:text="Batal"
                android:textColor="#475569"
                android:backgroundTint="#FFFFFF"
                android:insetBottom="0dp"
                android:insetTop="0dp"
                app:strokeColor="#CBD5E1"
                app:strokeWidth="1dp"
                android:layout_marginEnd="12dp"/>
    
            <Button
                android:id="@+id/btnSimpan"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="2"
                android:text="Simpan &amp; Selesaikan"
                android:textColor="#FFFFFF"
                android:backgroundTint="#4338CA"
                android:insetBottom="0dp"
                android:insetTop="0dp"/>
        </LinearLayout>
    </LinearLayout>

    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/progressBar"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_centerInParent="true"
        app:lottie_url="https://lottie.host/ff71b2dd-787e-4f88-9f79-79f0eb2c8641/OqV9rU5oMu.json"
        app:lottie_autoPlay="true"
        app:lottie_loop="true"
        android:visibility="gone" />

</RelativeLayout>

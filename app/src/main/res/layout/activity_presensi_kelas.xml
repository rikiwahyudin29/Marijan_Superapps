<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="HardcodedText,ContentDescription,Autofill"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F3F4F6">

    <!-- Header Detail Pelajaran -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#4F46E5"
        android:padding="16dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Presensi Kelas"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDetailPresensi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mata Pelajaran - Kelas"
            android:textColor="#E0E7FF"
            android:textSize="14sp"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <!-- Tombol Set Semua -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical|end"
        android:padding="16dp"
        android:background="#FFFFFF"
        android:elevation="2dp">
        
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SET SEMUA:"
            android:textStyle="bold"
            android:layout_marginEnd="12dp"
            android:textColor="#333333"/>
            
        <RadioGroup
            android:id="@+id/rgSetSemua"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_rounded_white">
            
            <RadioButton
                android:id="@+id/rbSetHadir"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="H"
                android:padding="8dp"
                android:textColor="#10B981"/>
            <RadioButton
                android:id="@+id/rbSetSakit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="S"
                android:padding="8dp"
                android:textColor="#3B82F6"/>
            <RadioButton
                android:id="@+id/rbSetIzin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="I"
                android:padding="8dp"
                android:textColor="#F59E0B"/>
            <RadioButton
                android:id="@+id/rbSetAlpa"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="A"
                android:padding="8dp"
                android:textColor="#EF4444"/>
        </RadioGroup>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvSiswa"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="8dp"
            android:clipToPadding="false"
            android:paddingBottom="80dp"/>
            
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone"/>
    </FrameLayout>

    <!-- Tombol Simpan Bawah -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:background="#FFFFFF"
        android:elevation="8dp">
        
        <Button
            android:id="@+id/btnSimpan"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Simpan Presensi"
            android:backgroundTint="#4F46E5"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>

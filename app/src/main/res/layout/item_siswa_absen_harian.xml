<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="HardcodedText,ContentDescription,UseCompoundDrawables"
    android:id="@+id/cvSiswaItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="1.5dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp"
        android:background="#FFFFFF">

        <!-- Baris 1: Nomor, Nama, NIS/Gender, & Status Badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <!-- Nomor Urut Circle -->
            <TextView
                android:id="@+id/tvNomorAbsen"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:gravity="center"
                android:background="@drawable/bg_icon_circle"
                android:backgroundTint="#F1F5F9"
                android:text="1"
                android:textColor="#475569"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginEnd="10dp" />

            <!-- Nama & Identitas -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvNamaSiswa"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nama Siswa Lengkap"
                    android:textColor="#0F172A"
                    android:textSize="13.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvNisDanGender"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="NISN: 0052324101 • Laki-laki"
                    android:textColor="#64748B"
                    android:textSize="11sp"
                    android:layout_marginTop="1dp" />
            </LinearLayout>

            <!-- Badge Status di Kanan Atas -->
            <TextView
                android:id="@+id/tvStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hadir"
                android:textColor="#059669"
                android:textSize="10sp"
                android:textStyle="bold"
                android:background="@drawable/bg_rounded_border"
                android:backgroundTint="#ECFDF5"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp" />
        </LinearLayout>

        <!-- Baris 2: 4 Tombol Pilihan Kehadiran (H / S / I / A) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- Tombol H (Hadir) -->
            <TextView
                android:id="@+id/btnPilihHadir"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:gravity="center"
                android:text="H"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:background="@drawable/bg_btn_absen_h_active"
                android:clickable="true"
                android:focusable="true" />

            <!-- Tombol S (Sakit) -->
            <TextView
                android:id="@+id/btnPilihSakit"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="4dp"
                android:gravity="center"
                android:text="S"
                android:textColor="#64748B"
                android:textSize="13sp"
                android:textStyle="bold"
                android:background="@drawable/bg_btn_absen_inactive"
                android:clickable="true"
                android:focusable="true" />

            <!-- Tombol I (Izin) -->
            <TextView
                android:id="@+id/btnPilihIzin"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="4dp"
                android:gravity="center"
                android:text="I"
                android:textColor="#64748B"
                android:textSize="13sp"
                android:textStyle="bold"
                android:background="@drawable/bg_btn_absen_inactive"
                android:clickable="true"
                android:focusable="true" />

            <!-- Tombol A (Alpha) -->
            <TextView
                android:id="@+id/btnPilihAlpha"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:gravity="center"
                android:text="A"
                android:textColor="#64748B"
                android:textSize="13sp"
                android:textStyle="bold"
                android:background="@drawable/bg_btn_absen_inactive"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <!-- Baris 3: Alert Keterangan Siswa (Jika Ada Surat Izin / Info) -->
        <LinearLayout
            android:id="@+id/llKeteranganContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_rounded_border"
            android:backgroundTint="#F8FAFC"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp"
            android:layout_marginTop="8dp"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:id="@+id/ivKeteranganIcon"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_modern_tugas"
                app:tint="#64748B"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/tvKeteranganText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Surat izin dokter diunggah orang tua"
                android:textColor="#64748B"
                android:textSize="11sp" />
        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>

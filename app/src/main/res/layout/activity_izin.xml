<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_animated_gradient">

    <!-- AppBar / Toolbar -->
    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:background="@android:color/transparent"
        android:elevation="2dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        
        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_baseline_arrow_back_24"
            app:tint="#1E293B"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless" />
            
        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="16dp"
            android:src="@drawable/logo_marj" />
            
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="8dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Marijan Superapps"
                android:textSize="10sp"
                android:textColor="#64748B" />
            <TextView
                android:id="@+id/tvHeaderTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pengajuan Izin"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#1E293B" />
        </LinearLayout>
        
        <!-- Profile Pic with initial and avatar support -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cvProfilPic"
            android:layout_width="36dp"
            android:layout_height="36dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#EEF2FF"
            android:clickable="true"
            android:foreground="?attr/selectableItemBackground">
            <TextView
                android:id="@+id/tvProfilInisial"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="U"
                android:textColor="#1E1B4B"
                android:textSize="13sp"
                android:textStyle="bold"
                android:visibility="visible" />
            <ImageView
                android:id="@+id/ivProfilPhoto"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:visibility="gone" />
        </androidx.cardview.widget.CardView>
    </LinearLayout>

    <ScrollView
        android:id="@+id/svFormIzin"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/headerLayout"
        app:layout_constraintBottom_toBottomOf="parent"
        android:paddingHorizontal="24dp"
        android:clipToPadding="false"
        android:paddingBottom="40dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="12dp">

            <!-- Banner Header -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#1E1B4B"
                android:layout_marginBottom="20dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">
                    
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/bg_rounded_border"
                        android:backgroundTint="#312E81"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="4dp">
                        <ImageView
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:src="@drawable/ic_modern_presensi"
                            app:tint="#A5B4FC"
                            android:layout_marginEnd="6dp" />
                        <TextView
                            android:id="@+id/tvKelas"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Form Pengajuan Izin / Sakit"
                            android:textColor="#A5B4FC"
                            android:textSize="10sp" />
                    </LinearLayout>
                    
                    <TextView
                        android:id="@+id/tvNamaDashboard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Pengajuan Izin Tidak Masuk"
                        android:textColor="#FFFFFF"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:layout_marginTop="12dp" />
                        
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Sampaikan permohonan izin atau sakit resmi kepada sekolah disertai foto bukti pendukung."
                        android:textColor="#A5B4FC"
                        android:textSize="12sp"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Form Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/card_bg"
                app:strokeWidth="1dp"
                app:strokeColor="@color/bg_light_grey"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Pilih Tanggal" android:textStyle="bold" android:textColor="@color/text_primary" android:textSize="14sp"/>
                    <EditText
                        android:id="@+id/etTanggalIzin"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:hint="Ketuk untuk pilih tanggal..."
                        android:textColorHint="@color/text_hint"
                        android:textColor="@color/text_input"
                        android:focusable="false"
                        android:clickable="true"
                        android:background="@drawable/bg_input_light_rounded"
                        android:paddingHorizontal="16dp"
                        android:textSize="15sp"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="16dp"/>

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Kategori" android:textStyle="bold" android:textColor="@color/text_primary" android:textSize="14sp"/>
                    <RadioGroup
                        android:id="@+id/rgStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="16dp">
                        
                        <RadioButton android:id="@+id/rbSakit" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sakit" android:buttonTint="@color/color_primary" android:textColor="@color/text_input" android:checked="true"/>
                        <RadioButton android:id="@+id/rbIzin" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Izin Keperluan" android:buttonTint="@color/color_primary" android:textColor="@color/text_input"/>
                        <RadioButton android:id="@+id/rbCuti" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Cuti" android:buttonTint="@color/color_primary" android:textColor="@color/text_input"/>
                        <RadioButton android:id="@+id/rbTerlambat" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Terlambat" android:buttonTint="@color/color_primary" android:textColor="@color/text_input"/>
                        <RadioButton android:id="@+id/rbDinasLuar" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Dinas Luar (DL)" android:buttonTint="@color/color_primary" android:textColor="@color/text_input"/>
                    </RadioGroup>

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Alasan / Keterangan" android:textStyle="bold" android:textColor="@color/text_primary" android:textSize="14sp"/>
                    <EditText
                        android:id="@+id/etKeterangan"
                        android:layout_width="match_parent"
                        android:layout_height="120dp"
                        android:hint="Tulis detail alasan di sini..."
                        android:textColorHint="@color/text_hint"
                        android:textColor="@color/text_input"
                        android:gravity="top"
                        android:background="@drawable/bg_input_light_rounded"
                        android:padding="16dp"
                        android:textSize="15sp"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="24dp"/>
                        
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/bg_light_grey" android:layout_marginBottom="24dp"/>

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Lampiran Bukti" android:textStyle="bold" android:textColor="@color/text_primary" android:textSize="14sp" android:layout_marginBottom="8dp"/>
                    <androidx.cardview.widget.CardView
                        android:id="@+id/btnPilihFile"
                        android:layout_width="match_parent"
                        android:layout_height="160dp"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="@color/bg_light_grey"
                        android:clickable="true"
                        android:foreground="?attr/selectableItemBackground">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="16dp">
                            <ImageView android:id="@+id/ivPreviewIzin" android:layout_width="48dp" android:layout_height="48dp" android:src="@android:drawable/ic_menu_camera" app:tint="@color/text_hint" android:scaleType="centerCrop"/>
                            <TextView android:id="@+id/tvLabelFile" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Ketuk untuk Buka Kamera" android:textColor="@color/color_primary" android:textStyle="bold" android:layout_marginTop="12dp"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Foto surat langsung dari aplikasi" android:textColor="@color/text_hint" android:textSize="12sp" android:layout_marginTop="4dp"/>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <FrameLayout
                        android:id="@+id/containerKameraInline"
                        android:layout_width="match_parent"
                        android:layout_height="280dp"
                        android:visibility="gone"
                        android:layout_marginBottom="8dp">
                        
                        <androidx.cardview.widget.CardView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="0dp">
                            <androidx.camera.view.PreviewView
                                android:id="@+id/viewFinderIzin"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent" />
                        </androidx.cardview.widget.CardView>
                        
                        <ImageView
                            android:id="@+id/btnFlipKamera"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@android:drawable/ic_popup_sync"
                            app:tint="#FFFFFF"
                            android:layout_margin="12dp"
                            android:layout_gravity="top|start"
                            android:clickable="true"
                            android:background="?attr/selectableItemBackgroundBorderless"/>

                        <ImageView
                            android:id="@+id/btnTutupKamera"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@android:drawable/ic_menu_close_clear_cancel"
                            app:tint="#FFFFFF"
                            android:layout_margin="12dp"
                            android:layout_gravity="top|end"
                            android:clickable="true"
                            android:background="?attr/selectableItemBackgroundBorderless"/>
                            
                        <androidx.cardview.widget.CardView
                            android:id="@+id/btnJepretIzin"
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            android:layout_gravity="bottom|center_horizontal"
                            android:layout_marginBottom="16dp"
                            app:cardCornerRadius="32dp"
                            app:cardBackgroundColor="#FFFFFF"
                            app:cardElevation="4dp"
                            android:clickable="true"
                            android:foreground="?attr/selectableItemBackgroundBorderless">
                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:padding="16dp"
                                android:src="@android:drawable/ic_menu_camera"
                                app:tint="@color/color_primary"/>
                        </androidx.cardview.widget.CardView>
                    </FrameLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <Button
                android:id="@+id/btnKirimIzin"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Kirim Pengajuan"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:backgroundTint="@color/color_primary"
                app:cornerRadius="12dp"/>
        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
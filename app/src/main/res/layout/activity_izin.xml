<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_animated_gradient">

    <include layout="@layout/layout_header_general" 
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ScrollView
        android:id="@+id/svFormIzin"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/headerLayout"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigation"
        android:paddingHorizontal="24dp"
        android:clipToPadding="false"
        android:paddingBottom="80dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="8dp">

            <!-- Form Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/card_bg"
                app:strokeWidth="1dp"
                app:strokeColor="@color/bg_light_grey"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Pilih Tanggal" android:textStyle="bold" android:textColor="@color/text_primary" android:textSize="14sp"/>
                    <EditText
                        android:id="@+id/etTanggalIzin"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:hint="Ketuk untuk pilih tanggal..."
                        android:textColorHint="@color/text_hint"
                        android:textColor="@color/text_input"
                        android:focusable="false"
                        android:clickable="true"
                        android:background="@drawable/bg_input_light_rounded"
                        android:paddingHorizontal="16dp"
                        android:textSize="15sp"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="16dp"/>

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Kategori" android:textStyle="bold" android:textColor="@color/text_primary" android:textSize="14sp"/>
                    <RadioGroup
                        android:id="@+id/rgStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="16dp">
                        
                        <RadioButton android:id="@+id/rbSakit" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sakit" android:buttonTint="@color/color_primary" android:textColor="@color/text_input" android:checked="true"/>
                        <RadioButton android:id="@+id/rbIzin" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Izin Keperluan" android:buttonTint="@color/color_primary" android:textColor="@color/text_input"/>
                        <RadioButton android:id="@+id/rbDinasLuar" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Dinas Luar (DL)" android:buttonTint="@color/color_primary" android:textColor="@color/text_input"/>
                    </RadioGroup>

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Alasan / Keterangan" android:textStyle="bold" android:textColor="@color/text_primary" android:textSize="14sp"/>
                    <EditText
                        android:id="@+id/etKeterangan"
                        android:layout_width="match_parent"
                        android:layout_height="120dp"
                        android:hint="Tulis detail alasan di sini..."
                        android:textColorHint="@color/text_hint"
                        android:textColor="@color/text_input"
                        android:gravity="top"
                        android:background="@drawable/bg_input_light_rounded"
                        android:padding="16dp"
                        android:textSize="15sp"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="24dp"/>
                        
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/bg_light_grey" android:layout_marginBottom="24dp"/>

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Lampiran Bukti" android:textStyle="bold" android:textColor="@color/text_primary" android:textSize="14sp" android:layout_marginBottom="8dp"/>
                    <androidx.cardview.widget.CardView
                        android:id="@+id/btnPilihFile"
                        android:layout_width="match_parent"
                        android:layout_height="160dp"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="@color/bg_light_grey"
                        android:clickable="true"
                        android:foreground="?attr/selectableItemBackground">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="16dp">
                            <ImageView android:id="@+id/ivPreviewIzin" android:layout_width="48dp" android:layout_height="48dp" android:src="@android:drawable/ic_menu_camera" app:tint="@color/text_hint" android:scaleType="centerCrop"/>
                            <TextView android:id="@+id/tvLabelFile" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Ketuk untuk Buka Kamera" android:textColor="@color/color_primary" android:textStyle="bold" android:layout_marginTop="12dp"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Foto surat langsung dari aplikasi" android:textColor="@color/text_hint" android:textSize="12sp" android:layout_marginTop="4dp"/>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <FrameLayout
                        android:id="@+id/containerKameraInline"
                        android:layout_width="match_parent"
                        android:layout_height="280dp"
                        android:visibility="gone"
                        android:layout_marginBottom="8dp">
                        
                        <androidx.cardview.widget.CardView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="0dp">
                            <androidx.camera.view.PreviewView
                                android:id="@+id/viewFinderIzin"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent" />
                        </androidx.cardview.widget.CardView>
                        
                        <ImageView
                            android:id="@+id/btnTutupKamera"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@android:drawable/ic_menu_close_clear_cancel"
                            app:tint="#FFFFFF"
                            android:layout_margin="12dp"
                            android:layout_gravity="top|end"
                            android:clickable="true"
                            android:background="?attr/selectableItemBackgroundBorderless"/>
                            
                        <androidx.cardview.widget.CardView
                            android:id="@+id/btnJepretIzin"
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            android:layout_gravity="bottom|center_horizontal"
                            android:layout_marginBottom="16dp"
                            app:cardCornerRadius="32dp"
                            app:cardBackgroundColor="#FFFFFF"
                            app:cardElevation="4dp"
                            android:clickable="true"
                            android:foreground="?attr/selectableItemBackgroundBorderless">
                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:padding="16dp"
                                android:src="@android:drawable/ic_menu_camera"
                                app:tint="@color/color_primary"/>
                        </androidx.cardview.widget.CardView>
                    </FrameLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <Button
                android:id="@+id/btnKirimIzin"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Kirim Pengajuan"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:backgroundTint="@color/color_primary"
                app:cornerRadius="12dp"/>
        </LinearLayout>
    </ScrollView>

    <!-- Bottom Navigation Wrapper -->
    <FrameLayout
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:background="@android:color/transparent"
        android:elevation="0dp">

    <!-- Bottom Navigation Area (Siswa) -->
    <LinearLayout
        android:id="@+id/bottomNavigationSiswa"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingHorizontal="4dp"
        android:weightSum="6">

            <LinearLayout android:id="@+id/navBeranda" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground">
                <ImageView android:id="@+id/ivNavBeranda" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_modern_cbt" app:tint="#9CA3AF" />
                <TextView android:id="@+id/tvNavBeranda" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Beranda" android:textColor="#9CA3AF" android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout android:id="@+id/navAkademik" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground">
                <ImageView android:id="@+id/ivNavAkademik" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_modern_materi" app:tint="#9CA3AF" />
                <TextView android:id="@+id/tvNavAkademik" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Akademik" android:textColor="#9CA3AF" android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout android:id="@+id/navCbt" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:layout_marginEnd="16dp" android:orientation="vertical" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground">
                <ImageView android:id="@+id/ivNavCbt" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_modern_tugas" app:tint="#9CA3AF" />
                <TextView android:id="@+id/tvNavCbt" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="CBT" android:textColor="#9CA3AF" android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout android:id="@+id/navPresensi" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:layout_marginStart="16dp" android:orientation="vertical" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground">
                <ImageView android:id="@+id/ivNavPresensi" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_modern_presensi" app:tint="@color/color_primary" />
                <TextView android:id="@+id/tvNavPresensi" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Presensi" android:textColor="@color/color_primary" android:textStyle="bold" android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout android:id="@+id/navKeuangan" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground">
                <ImageView android:id="@+id/ivNavKeuangan" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_modern_keuangan" app:tint="#9CA3AF" />
                <TextView android:id="@+id/tvNavKeuangan" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Keuangan" android:textColor="#9CA3AF" android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout android:id="@+id/navProfil" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground">
                <ImageView android:id="@+id/ivNavProfil" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_modern_profile" app:tint="#9CA3AF" />
                <TextView android:id="@+id/tvNavProfil" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Profil" android:textColor="#9CA3AF" android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>

    <!-- Bottom Navigation Area (Guru) -->
    <LinearLayout
        android:id="@+id/bottomNavigationGuru"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingHorizontal="4dp"
        android:weightSum="4">

            <!-- 1. Beranda -->
            <LinearLayout android:id="@+id/navBerandaGuru" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground">
                <ImageView android:id="@+id/ivNavBerandaGuru" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_modern_home" app:tint="#9CA3AF" />
                <TextView android:id="@+id/tvNavBerandaGuru" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Beranda" android:textColor="#9CA3AF" android:textSize="10sp" />
            </LinearLayout>

            <!-- 2. Presensi (Active by default for Izin) -->
            <LinearLayout android:id="@+id/navPresensiGuru" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:layout_marginEnd="20dp" android:orientation="vertical" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground">
                <ImageView android:id="@+id/ivNavPresensiGuru" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_modern_presensi" app:tint="@color/color_primary" />
                <TextView android:id="@+id/tvNavPresensiGuru" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Presensi" android:textColor="@color/color_primary" android:textStyle="bold" android:textSize="10sp" />
            </LinearLayout>

            <!-- 3. Akademik -->
            <LinearLayout android:id="@+id/navAkademikGuru" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:layout_marginStart="20dp" android:orientation="vertical" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground">
                <ImageView android:id="@+id/ivNavAkademikGuru" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_modern_akademik" app:tint="#9CA3AF" />
                <TextView android:id="@+id/tvNavAkademikGuru" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Akademik" android:textColor="#9CA3AF" android:textSize="10sp" />
            </LinearLayout>

            <!-- 4. Profil -->
            <LinearLayout android:id="@+id/navProfilGuru" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground">
                <ImageView android:id="@+id/ivNavProfilGuru" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_modern_profile" app:tint="#9CA3AF" />
                <TextView android:id="@+id/tvNavProfilGuru" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Profil" android:textColor="#9CA3AF" android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
        
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabScanner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="35dp"
        android:src="@drawable/ic_qr_code"
        app:backgroundTint="#1E3A8A"
        app:tint="#FFFFFF"
        app:elevation="20dp"
        app:fabSize="normal" />

</androidx.constraintlayout.widget.ConstraintLayout>
<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <ScrollView
        android:id="@+id/scrollViewAkademik"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="100dp"
        android:scrollbars="none"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp">

            <!-- ========================================== -->
            <!-- 1. HERO GRADIENT CARD                      -->
            <!-- ========================================== -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="24dp"
                app:cardElevation="3dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_akademik_hero"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Top Bar: Semester Badge & Date -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvTahunAjaranSemester"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_badge_ta_pill"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="5dp"
                            android:text="• TA 2026/2027 • GANJIL"
                            android:textColor="#FFFFFF"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />

                        <TextView
                            android:id="@+id/tvTanggalHariIni"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Senin, 18 Ags 2026"
                            android:textColor="#C7D2FE"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- Category Header -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:letterSpacing="0.06"
                        android:text="PORTAL AKADEMIK TERPADU"
                        android:textColor="#38BDF8"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <!-- Main Title -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Akademik &amp; Pembelajaran"
                        android:textColor="#FFFFFF"
                        android:textSize="21sp"
                        android:textStyle="bold" />

                    <!-- Subtitle -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:lineSpacingExtra="3dp"
                        android:text="Kelola kegiatan belajar, materi, tugas kelas, dan rekap capaian nilai rapor secara mudah &amp; real-time."
                        android:textColor="#E0E7FF"
                        android:textSize="12sp" />

                    <!-- Student Info Strip -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/bg_akademik_student_strip"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="12dp">

                        <TextView
                            android:id="@+id/tvTingkatCircle"
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:background="@drawable/bg_akademik_circle_tingkat"
                            android:gravity="center"
                            android:text="12"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_marginEnd="8dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvNamaSiswaHero"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="Siswa MA Riyadhul Jannah"
                                android:textColor="#FFFFFF"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvKelasNisnHero"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="Kelas • NISN"
                                android:textColor="#6EE7B7"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvJurusanBadgeHero"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_badge_jurusan_pill"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="4dp"
                            android:text="TKJT"
                            android:textColor="#FFFFFF"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Effective Week Progress Box -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_akademik_student_strip"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvMingguEfektifLabel"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Minggu Efektif KBM (Pekan 7/18)"
                                android:textColor="#FFFFFF"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/tvPersenSelesaiLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="38% Selesai"
                                android:textColor="#38BDF8"
                                android:textSize="11sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <ProgressBar
                            android:id="@+id/pbMingguEfektif"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="8dp"
                            android:layout_marginTop="8dp"
                            android:max="100"
                            android:progress="38"
                            android:progressDrawable="@drawable/bg_progress_kbm_track" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ========================================== -->
            <!-- 2. RINGKASAN AKADEMIK                      -->
            <!-- ========================================== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:letterSpacing="0.04"
                    android:text="RINGKASAN AKADEMIK"
                    android:textColor="#64748B"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnRincianLengkap"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:text="Rincian Lengkap →"
                    android:textColor="#059669"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 3 Horizontal Metric Cards -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:baselineAligned="false"
                android:orientation="horizontal"
                android:weightSum="3">

                <!-- Card 1: Rata-Rata Raport -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardRataRata"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_ringkasan_card"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:ellipsize="end"
                                android:maxLines="2"
                                android:text="RATA-RATA\nRAPORT"
                                android:textColor="#94A3B8"
                                android:textSize="9sp"
                                android:textStyle="bold" />

                            <ImageView
                                android:layout_width="26dp"
                                android:layout_height="26dp"
                                android:background="@drawable/bg_badge_green_soft"
                                android:padding="5dp"
                                android:src="@drawable/ic_modern_profile"
                                app:tint="#059669" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvRataRataNilai"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="88.5"
                            android:textColor="#0F172A"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvRataRataBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/bg_badge_green_soft"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="2dp"
                            android:text="+2.4 pts"
                            android:textColor="#059669"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Card 2: Tugas Aktif -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardTugasAktif"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="4dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_ringkasan_card"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:ellipsize="end"
                                android:maxLines="2"
                                android:text="TUGAS\nAKTIF"
                                android:textColor="#94A3B8"
                                android:textSize="9sp"
                                android:textStyle="bold" />

                            <ImageView
                                android:layout_width="26dp"
                                android:layout_height="26dp"
                                android:background="@drawable/bg_badge_red_soft"
                                android:padding="5dp"
                                android:src="@drawable/ic_modern_tugas"
                                app:tint="#DC2626" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="bottom"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvTugasAktifCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="2"
                                android:textColor="#0F172A"
                                android:textSize="20sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:layout_marginBottom="2dp"
                                android:text="Tugas"
                                android:textColor="#64748B"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvTugasUrgentBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/bg_badge_red_soft"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="2dp"
                            android:text="1 Urgent"
                            android:textColor="#DC2626"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Card 3: Total Materi -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardTotalMateri"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_ringkasan_card"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:ellipsize="end"
                                android:maxLines="2"
                                android:text="TOTAL\nMATERI"
                                android:textColor="#94A3B8"
                                android:textSize="9sp"
                                android:textStyle="bold" />

                            <ImageView
                                android:layout_width="26dp"
                                android:layout_height="26dp"
                                android:background="@drawable/bg_badge_purple_soft"
                                android:padding="5dp"
                                android:src="@drawable/ic_modern_materi"
                                app:tint="#7C3AED" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="bottom"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvTotalMateriCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="18"
                                android:textColor="#0F172A"
                                android:textSize="20sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:layout_marginBottom="2dp"
                                android:text="Modul"
                                android:textColor="#64748B"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvMateriBaruBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/bg_badge_blue_soft"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="2dp"
                            android:text="3 Baru"
                            android:textColor="#059669"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <!-- ========================================== -->
            <!-- 3. MENU UTAMA AKADEMIK                     -->
            <!-- ========================================== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:letterSpacing="0.04"
                android:text="MENU UTAMA AKADEMIK"
                android:textColor="#64748B"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- 4 Action Cards (Jadwal, Tugas, Materi, Nilai Raport) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:baselineAligned="false"
                android:orientation="horizontal"
                android:weightSum="4">

                <!-- Action 1: Jadwal Pelajaran -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/btnMenuJadwal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="3dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="0dp"
                    android:clickable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_ringkasan_card"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingHorizontal="4dp"
                        android:paddingVertical="15dp">

                        <ImageView
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="@drawable/bg_btn_primary"
                            android:backgroundTint="#0284C7"
                            android:padding="11dp"
                            android:src="@drawable/ic_modern_jadwal"
                            app:tint="#FFFFFF" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="Jadwal"
                            android:textColor="#0F172A"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvSubMenuJadwal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="Jadwal KBM"
                            android:textColor="#0284C7"
                            android:textSize="9.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Action 2: Tugas -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/btnMenuTugas"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="2dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="0dp"
                    android:clickable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_ringkasan_card"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingHorizontal="4dp"
                        android:paddingVertical="15dp">

                        <ImageView
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="@drawable/bg_btn_primary"
                            android:backgroundTint="#059669"
                            android:padding="11dp"
                            android:src="@drawable/ic_modern_tugas"
                            app:tint="#FFFFFF" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="Tugas"
                            android:textColor="#0F172A"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvSubMenuTugas"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="2 Belum Selesai"
                            android:textColor="#EF4444"
                            android:textSize="9.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Action 3: Materi -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/btnMenuMateri"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="2dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="0dp"
                    android:clickable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_ringkasan_card"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingHorizontal="4dp"
                        android:paddingVertical="15dp">

                        <ImageView
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="@drawable/bg_btn_primary"
                            android:backgroundTint="#6D28D9"
                            android:padding="11dp"
                            android:src="@drawable/ic_modern_materi"
                            app:tint="#FFFFFF" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="Materi"
                            android:textColor="#0F172A"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvSubMenuMateri"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="18 Modul PDF"
                            android:textColor="#6D28D9"
                            android:textSize="9.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Action 4: Nilai Raport -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/btnMenuRaport"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="3dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="0dp"
                    android:clickable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_ringkasan_card"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingHorizontal="4dp"
                        android:paddingVertical="15dp">

                        <ImageView
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="@drawable/bg_btn_primary"
                            android:backgroundTint="#059669"
                            android:padding="11dp"
                            android:src="@drawable/ic_check_circle_24"
                            app:tint="#FFFFFF" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="Raport"
                            android:textColor="#0F172A"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvSubMenuRaport"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="Transkrip Nilai"
                            android:textColor="#059669"
                            android:textSize="9.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <!-- ========================================== -->
            <!-- 4. SEDANG BERLANGSUNG (KBM CARD)           -->
            <!-- ========================================== -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cvKbmOngoing"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_kbm_active"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <!-- Status Pill & Time Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvKbmStatusBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_badge_red_soft"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="4dp"
                            android:text="• SEDANG BERLANGSUNG"
                            android:textColor="#DC2626"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />

                        <TextView
                            android:id="@+id/tvKbmWaktu"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Jam Ke 4 - 5 • 08:20 - 09:40 WIB"
                            android:textColor="#94A3B8"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- Subject Title -->
                    <TextView
                        android:id="@+id/tvKbmMapel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Teknologi Jaringan Kabel dan Nirkabel"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <!-- Teacher & Room -->
                    <TextView
                        android:id="@+id/tvKbmGuruRuang"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Iwan Setiawan, S.T. • Lab Komputer 2 (CBT 2)"
                        android:textColor="#6EE7B7"
                        android:textSize="12sp" />

                    <!-- Action Buttons: Lihat Jadwal Pelajaran & Buka Modul KBM -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="horizontal"
                        android:weightSum="2">

                        <TextView
                            android:id="@+id/btnLihatJadwalKbm"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="6dp"
                            android:background="@drawable/bg_btn_primary"
                            android:backgroundTint="#059669"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackground"
                            android:gravity="center"
                            android:paddingVertical="12dp"
                            android:text="Lihat Jadwal"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/btnBukaModulKbm"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/bg_btn_kbm_modul"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackground"
                            android:gravity="center"
                            android:paddingVertical="12dp"
                            android:text="Buka Modul"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ========================================== -->
            <!-- 5. TUGAS MENDATANG                         -->
            <!-- ========================================== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.04"
                    android:text="TUGAS MENDATANG"
                    android:textColor="#64748B"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvCountTugasBadge"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_badge_red_soft"
                    android:gravity="center"
                    android:text="2"
                    android:textColor="#DC2626"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/btnSemuaTugas"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:text="Semua Tugas"
                    android:textColor="#059669"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Dynamic Tasks Container -->
            <LinearLayout
                android:id="@+id/llTugasMendatang"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical">

                <!-- Placeholder empty state view (hidden when real items exist) -->
                <TextView
                    android:id="@+id/tvEmptyTugas"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_ringkasan_card"
                    android:gravity="center"
                    android:padding="20dp"
                    android:text="Tidak ada tugas mendatang saat ini 🎉"
                    android:textColor="#94A3B8"
                    android:textSize="13sp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- ========================================== -->
            <!-- 6. AKTIVITAS & MATERI TERKINI              -->
            <!-- ========================================== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:letterSpacing="0.04"
                    android:text="AKTIVITAS &amp; MATERI TERKINI"
                    android:textColor="#64748B"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnLihatSemuaMateri"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:text="Lihat Semua"
                    android:textColor="#059669"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Dynamic Materials Container -->
            <LinearLayout
                android:id="@+id/llMateriTerkini"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical">

                <!-- Placeholder empty state view -->
                <TextView
                    android:id="@+id/tvEmptyMateri"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_ringkasan_card"
                    android:gravity="center"
                    android:padding="20dp"
                    android:text="Belum ada materi terbaru yang dibagikan."
                    android:textColor="#94A3B8"
                    android:textSize="13sp"
                    android:visibility="gone" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>

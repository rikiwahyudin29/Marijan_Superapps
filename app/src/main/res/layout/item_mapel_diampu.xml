<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="18dp"
    app:cardElevation="0.5dp"
    app:cardBackgroundColor="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Rounded Icon Container -->
            <FrameLayout
                android:id="@+id/flMapelIconBg"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_rounded_border"
                android:backgroundTint="#EDE9FE"
                android:layout_marginEnd="14dp">

                <ImageView
                    android:id="@+id/ivMapelIcon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_modern_materi"
                    app:tint="#6D28D9" />
            </FrameLayout>

            <!-- Title & Class / Modul -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvNamaMapel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Dasar Dasar Teknik Jaringan Komputer dan Telekomunikasi"
                    android:textColor="#0F172A"
                    android:textSize="13.5sp"
                    android:textStyle="bold"
                    android:maxLines="2"
                    android:ellipsize="end" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="4dp">

                    <ImageView
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:src="@drawable/ic_modern_profile"
                        app:tint="#64748B"
                        android:layout_marginEnd="4dp"/>

                    <TextView
                        android:id="@+id/tvNamaKelas"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Kelas 10 TKJT 1"
                        android:textColor="#64748B"
                        android:textSize="11.5sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" • "
                        android:textColor="#94A3B8"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvModulInfo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Modul 4 / 12"
                        android:textColor="#2563EB"
                        android:textSize="11.5sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Right: Jam / Minggu -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="end"
                android:layout_marginStart="8dp">

                <TextView
                    android:id="@+id/tvTotalJam"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="10"
                    android:textColor="#1E1B4B"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Jam/Mg"
                    android:textColor="#64748B"
                    android:textSize="9.5sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Progress Bar Line -->
        <ProgressBar
            android:id="@+id/pbMapelModul"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="10dp"
            android:max="100"
            android:progress="35"
            android:progressDrawable="@drawable/bg_progress_blue" />
    </LinearLayout>
</androidx.cardview.widget.CardView>

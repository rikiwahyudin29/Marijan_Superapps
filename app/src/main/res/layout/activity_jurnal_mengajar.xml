<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_animated_gradient"
    tools:ignore="HardcodedText,Autofill,ContentDescription,ButtonStyle,MissingPrefix">

    <!-- App Bar Header -->
    <LinearLayout
        android:id="@+id/appBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:background="#FFFFFF"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="#1F2937" />

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:src="@drawable/logo_marj" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SMK RJ SUPERAPPS"
                android:textColor="#1F2937"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Jurnal Kegiatan Guru"
                android:textColor="#6B7280"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_green_dark"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:text="● Aktif"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/appBar"
        android:layout_above="@+id/bottomBar"
        android:clipToPadding="false"
        android:paddingBottom="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Top Header Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp">
                
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#2645AC"
                    android:orientation="vertical"
                    android:padding="16dp">
                    
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp">
                        
                        <TextView
                            android:id="@+id/tvPertemuanBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_badge_light_blue"
                            android:text="Pertemuan Baru"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="4dp"/>
                            
                        <TextView
                            android:id="@+id/tvTanggal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:text="Hari, Tanggal"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp"
                            android:textStyle="bold"/>
                    </RelativeLayout>
                    
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Form Jurnal Mengajar"
                        android:textColor="#FFFFFF"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="4dp"/>
                        
                    <TextView
                        android:id="@+id/tvDetailPelajaran"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Nama Mata Pelajaran - Kelas"
                        android:textColor="#E2E8F0"
                        android:textSize="12sp"
                        android:layout_marginBottom="16dp"/>
                        
                    <!-- Stats Placeholder -->
                    <LinearLayout
                        android:id="@+id/layoutStats"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:visibility="gone"> 
                        
                        <View android:layout_width="6dp" android:layout_height="6dp" android:background="@drawable/bg_circle_green" android:layout_marginEnd="4dp"/>
                        <TextView android:id="@+id/tvHadir" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0 Hadir" android:textColor="#FFFFFF" android:textSize="10sp" android:layout_marginEnd="12dp"/>
                        
                        <View android:layout_width="6dp" android:layout_height="6dp" android:background="@drawable/bg_circle_yellow" android:layout_marginEnd="4dp"/>
                        <TextView android:id="@+id/tvIzin" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0 Izin" android:textColor="#FFFFFF" android:textSize="10sp" android:layout_marginEnd="12dp"/>
                        
                        <View android:layout_width="6dp" android:layout_height="6dp" android:background="@drawable/bg_circle_red" android:layout_marginEnd="4dp"/>
                        <TextView android:id="@+id/tvSakit" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0 Sakit" android:textColor="#FFFFFF" android:textSize="10sp" android:layout_marginEnd="12dp"/>
                        
                        <View android:layout_width="6dp" android:layout_height="6dp" android:background="@drawable/bg_circle_gray" android:layout_marginEnd="4dp"/>
                        <TextView android:id="@+id/tvAlpha" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0 Alfa" android:textColor="#FFFFFF" android:textSize="10sp"/>
                        
                        <Space android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"/>
                        <TextView android:id="@+id/tvTotalSiswa" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Total: 0 Siswa" android:textColor="#FFFFFF" android:textSize="10sp" android:textStyle="bold"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Jam Ke Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp">
                
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:background="#FFFFFF">
                    
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp">
                        
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="JAM KE *"
                            android:textColor="#1E293B"
                            android:textSize="12sp"
                            android:textStyle="bold"/>
                            
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:text="Sesuai Jadwal"
                            android:textColor="#3B82F6"
                            android:textSize="10sp"
                            android:background="@drawable/bg_badge_blue_outline"
                            android:paddingHorizontal="6dp"
                            android:paddingVertical="2dp"/>
                    </RelativeLayout>
                    
                    <EditText
                        android:id="@+id/etJamKe"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_input_rounded"
                        android:paddingHorizontal="16dp"
                        android:hint="Contoh: 1-2"
                        android:textSize="14sp"
                        android:textColor="#1E293B"
                        android:focusable="false"
                        android:clickable="false"
                        android:cursorVisible="false"
                        android:inputType="none"/>
                        
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Materi Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp">
                
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:background="#FFFFFF">
                    
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp">
                        
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="MATERI POKOK / PEMBAHASAN *"
                            android:textColor="#1E293B"
                            android:textSize="12sp"
                            android:textStyle="bold"/>
                            
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:text="Wajib Diisi"
                            android:textColor="#D97706"
                            android:textSize="10sp"
                            android:background="@drawable/bg_badge_yellow_outline"
                            android:paddingHorizontal="6dp"
                            android:paddingVertical="2dp"/>
                    </RelativeLayout>
                    
                    <EditText
                        android:id="@+id/etMateri"
                        android:layout_width="match_parent"
                        android:layout_height="100dp"
                        android:background="@drawable/bg_input_rounded"
                        android:padding="12dp"
                        android:hint="Materi yang diajarkan hari ini...\nContoh: Pengenalan topologi star..."
                        android:textSize="14sp"
                        android:textColor="#1E293B"
                        android:gravity="top|start"
                        android:inputType="textMultiLine"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Catatan Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp">
                
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:background="#FFFFFF">
                    
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp">
                        
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="CATATAN KEJADIAN DI KELAS *"
                            android:textColor="#1E293B"
                            android:textSize="12sp"
                            android:textStyle="bold"/>
                            
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:text="Wajib Diisi"
                            android:textColor="#EF4444"
                            android:textSize="10sp"
                            android:background="@drawable/bg_badge_red_outline"
                            android:paddingHorizontal="6dp"
                            android:paddingVertical="2dp"/>
                    </RelativeLayout>
                    
                    <EditText
                        android:id="@+id/etCatatan"
                        android:layout_width="match_parent"
                        android:layout_height="100dp"
                        android:background="@drawable/bg_input_rounded"
                        android:padding="12dp"
                        android:hint="Tuliskan catatan kejadian penting di kelas, siswa yang aktif, kendala teknis perangkat..."
                        android:textSize="14sp"
                        android:textColor="#1E293B"
                        android:gravity="top|start"
                        android:inputType="textMultiLine"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Foto Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp">
                
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:background="#FFFFFF">
                    
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp">
                        
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="FOTO KEGIATAN PEMBELAJARAN *"
                            android:textColor="#1E293B"
                            android:textSize="12sp"
                            android:textStyle="bold"/>
                            
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:text="Wajib Unggah"
                            android:textColor="#EF4444"
                            android:textSize="10sp"
                            android:background="@drawable/bg_badge_red_outline"
                            android:paddingHorizontal="6dp"
                            android:paddingVertical="2dp"/>
                    </RelativeLayout>
                    
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ambil foto real-time suasana KBM di ruang kelas/lab"
                        android:textColor="#64748B"
                        android:textSize="12sp"
                        android:layout_marginBottom="12dp"/>
                        
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="220dp"
                        android:background="@drawable/bg_camera_preview"
                        android:clipChildren="true"
                        android:clipToPadding="true">
                        
                        <androidx.camera.view.PreviewView
                            android:id="@+id/viewFinder"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent" />
                            
                        <ImageView
                            android:id="@+id/ivPreview"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:visibility="gone" />
                            
                        <TextView
                            android:id="@+id/tvKameraSiap"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_margin="12dp"
                            android:text="Kamera Siap"
                            android:textColor="#22C55E"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:background="@drawable/bg_badge_green_dark"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="4dp"/>
                            
                        <ImageButton
                            android:id="@+id/btnSwitchCamera"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_gravity="top|end"
                            android:layout_margin="12dp"
                            android:background="@drawable/bg_circle_dark_trans"
                            android:src="@android:drawable/ic_menu_rotate"
                            app:tint="#FFFFFF"
                            android:padding="8dp" />
                            
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="bottom|center_horizontal"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:layout_marginBottom="16dp">
                            
                            <ImageButton
                                android:id="@+id/btnCapture"
                                android:layout_width="56dp"
                                android:layout_height="56dp"
                                android:background="@drawable/bg_circle_camera_capture"
                                android:src="@android:drawable/ic_menu_camera"
                                app:tint="#2645AC"
                                android:padding="12dp"
                                android:layout_marginBottom="8dp"/>
                                
                            <TextView
                                android:id="@+id/tvCaptureHint"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Ketuk untuk Ambil Foto Langsung"
                                android:textColor="#FFFFFF"
                                android:textSize="10sp"/>
                                
                            <Button
                                android:id="@+id/btnRetake"
                                android:layout_width="wrap_content"
                                android:layout_height="36dp"
                                android:text="Ulangi Foto"
                                android:textSize="12sp"
                                android:textColor="#FFFFFF"
                                android:backgroundTint="#EF4444"
                                android:visibility="gone"/>
                        </LinearLayout>
                    </FrameLayout>
                    
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp">
                        
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Format: JPG, PNG (Maks. 5MB)"
                            android:textColor="#94A3B8"
                            android:textSize="10sp"
                            android:layout_centerVertical="true"/>
                            
                    </RelativeLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </ScrollView>

    <!-- Bottom Sticky Bar -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="#FFFFFF"
        android:orientation="horizontal"
        android:padding="16dp"
        android:elevation="8dp">

        <Button
            android:id="@+id/btnBatal"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:text="Batal"
            android:textColor="#475569"
            android:backgroundTint="#FFFFFF"
            android:insetBottom="0dp"
            android:insetTop="0dp"
            app:strokeColor="#CBD5E1"
            app:strokeWidth="1dp"
            android:layout_marginEnd="8dp"/>

        <Button
            android:id="@+id/btnLanjut"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:text="Lanjut ke Presensi"
            android:textColor="#FFFFFF"
            android:backgroundTint="#2645AC"
            android:insetBottom="0dp"
            android:insetTop="0dp"
            android:layout_marginStart="8dp"/>
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:visibility="gone" />

</RelativeLayout>

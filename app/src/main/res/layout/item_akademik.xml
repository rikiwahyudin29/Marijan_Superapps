<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="#FFFFFF"
    app:strokeWidth="1dp"
    app:strokeColor="#E5E7EB">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp">
            <TextView
                android:id="@+id/tvMapel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MATEMATIKA"
                android:textSize="11sp"
                android:textColor="#10B981"
                android:textStyle="bold"/>
            <TextView
                android:id="@+id/tvBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="BELUM"
                android:textSize="10sp"
                android:textColor="#DC2626"
                android:textStyle="bold"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:background="#FEE2E2" />
        </RelativeLayout>

        <TextView
            android:id="@+id/tvJudulAkademik"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Aljabar Linear Lanjut"
            android:textSize="16sp"
            android:textColor="#111827"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tvGuruInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Oleh: Pak Riki Wahyudin  |  Tenggat: 15 Mei"
            android:textSize="12sp"
            android:textColor="#6B7280"
            android:layout_marginTop="4dp"/>

        <LinearLayout
            android:id="@+id/layNilaiKomentar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginTop="12dp"
            android:background="#F3F4F6"
            android:padding="12dp">
            
            <TextView
                android:id="@+id/tvNilai"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nilai: -"
                android:textColor="#059669"
                android:textStyle="bold"
                android:textSize="14sp"/>

            <TextView
                android:id="@+id/tvKomentarGuru"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Komentar: -"
                android:textColor="#374151"
                android:textSize="12sp"
                android:layout_marginTop="4dp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp">
            
            <Button
                android:id="@+id/btnAksiAkademik"
                android:layout_width="0dp"
                android:layout_height="45dp"
                android:layout_weight="1"
                android:text="Buka &amp; Kerjakan"
                android:textAllCaps="false"
                android:textSize="14sp"
                android:textStyle="bold"
                android:backgroundTint="#1F2937"
                android:textColor="#FFFFFF"
                app:cornerRadius="10dp" />

            <Button
                android:id="@+id/btnPerbaruiJawaban"
                android:layout_width="0dp"
                android:layout_height="45dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:visibility="gone"
                android:text="Perbarui"
                android:textAllCaps="false"
                android:textSize="14sp"
                android:textStyle="bold"
                android:backgroundTint="#10B981"
                android:textColor="#FFFFFF"
                app:cornerRadius="10dp" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
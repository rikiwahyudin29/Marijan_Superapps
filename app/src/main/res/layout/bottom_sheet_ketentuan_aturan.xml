<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet"
    android:paddingHorizontal="20dp"
    android:paddingTop="12dp"
    android:paddingBottom="24dp">

    <!-- Handle Bar -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:background="@drawable/bg_rounded_border"
        android:backgroundTint="#CBD5E1"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp" />

    <!-- Header Modal -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:gravity="center"
            android:background="@drawable/bg_circle_green"
            android:backgroundTint="#FEF3C7">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_modern_tugas"
                app:tint="#D97706" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ketentuan &amp; Aturan Presensi"
                android:textColor="#0F172A"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pedoman Kehadiran SMK Riyadhul Jannah"
                android:textColor="#64748B"
                android:textSize="11sp"
                android:layout_marginTop="1dp" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E2E8F0"
        android:layout_marginVertical="14dp" />

    <!-- Item 1: Jam Shift Kerja -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="20dp"
            android:layout_height="wrap_content"
            android:text="1."
            android:textColor="#0D9488"
            android:textSize="12.5sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Jam Shift Kerja Reguler"
                android:textColor="#1E293B"
                android:textSize="12.5sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Jam kerja reguler berlangsung dari pukul 06:30 WIB sampai dengan 14:45 WIB."
                android:textColor="#64748B"
                android:textSize="11sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Item 2: Toleransi Masuk -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="20dp"
            android:layout_height="wrap_content"
            android:text="2."
            android:textColor="#0D9488"
            android:textSize="12.5sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Batas Presensi Masuk &amp; Keterlambatan"
                android:textColor="#1E293B"
                android:textSize="12.5sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Presensi masuk dibuka mulai 06:00 WIB. Presensi di atas 07:00 WIB akan tercatat sebagai Terlambat secara otomatis."
                android:textColor="#64748B"
                android:textSize="11sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Item 3: Presensi Pulang -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="20dp"
            android:layout_height="wrap_content"
            android:text="3."
            android:textColor="#0D9488"
            android:textSize="12.5sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Waktu Kepulangan"
                android:textColor="#1E293B"
                android:textSize="12.5sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Presensi pulang dibuka mulai pukul 14:45 WIB. Sebelum jam tersebut tombol kepulangan berstatus menunggu."
                android:textColor="#64748B"
                android:textSize="11sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Item 4: Radius & Geofencing -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="20dp"
            android:layout_height="wrap_content"
            android:text="4."
            android:textColor="#0D9488"
            android:textSize="12.5sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Radius Geofencing GPS"
                android:textColor="#1E293B"
                android:textSize="12.5sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Presensi mandiri kamera &amp; QR hanya valid jika posisi berada dalam radius maksimal 50 meter dari titik pusat sekolah."
                android:textColor="#64748B"
                android:textSize="11sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Item 5: Izin & Dinas Luar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="20dp"
            android:layout_height="wrap_content"
            android:text="5."
            android:textColor="#0D9488"
            android:textSize="12.5sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Izin Sakit &amp; Penugasan Dinas Luar"
                android:textColor="#1E293B"
                android:textSize="12.5sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bagi guru yang sakit atau ditugaskan dinas luar, wajib mengajukan izin online melalui aplikasi dengan melampirkan foto surat dokter atau surat tugas."
                android:textColor="#64748B"
                android:textSize="11sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>

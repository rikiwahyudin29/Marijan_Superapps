<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_animated_gradient"
    tools:ignore="HardcodedText,ContentDescription,Autofill,UseCompoundDrawables">

    <!-- 1. STANDAR TOP BAR HEADER (Senada dengan Layar Lainnya, Tanpa Badge Wali Kelas) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:background="@android:color/transparent"
        android:elevation="2dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_baseline_arrow_back_24"
            app:tint="#1E293B"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"/>

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="14dp"
            android:src="@drawable/logo_marj" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SMK RJ SUPERAPPS"
                android:textSize="9sp"
                android:letterSpacing="0.05"
                android:textColor="#64748B"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvHeaderTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rekap Keuangan Binaan"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#1E293B" />
        </LinearLayout>

        <!-- Profile Pic -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cvProfilPic"
            android:layout_width="36dp"
            android:layout_height="36dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            android:clickable="true"
            android:foreground="?attr/selectableItemBackground">
            <ImageView
                android:id="@+id/ivProfilPhoto"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@android:drawable/ic_menu_myplaces"
                android:scaleType="centerCrop"/>
        </androidx.cardview.widget.CardView>
    </LinearLayout>

    <!-- 2. SCROLLABLE CONTENT BODY -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="36dp">

            <!-- HERO CARD (INDIGO ELEGAN #1E1B4B) -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#1E1B4B">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <!-- Baris 1: Tag Kelas, Kelas Binaan, Tahun Ajaran -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/tvKelasBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="12 TKJ 1"
                            android:textColor="#FFFFFF"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:background="@drawable/bg_rounded_border"
                            android:backgroundTint="#312E81"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="4dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Kelas Binaan"
                            android:textColor="#C7D2FE"
                            android:textSize="10.5sp"
                            android:textStyle="bold"
                            android:background="@drawable/bg_rounded_border"
                            android:backgroundTint="#3730A3"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="4dp"
                            android:layout_marginStart="6dp" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />

                        <TextView
                            android:id="@+id/tvTahunAjaranBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="TA 2026/2027 • Ganjil"
                            android:textColor="#A5B4FC"
                            android:textSize="10.5sp" />
                    </LinearLayout>

                    <!-- Judul Hero -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Rekapitulasi Keuangan Siswa"
                        android:textColor="#FFFFFF"
                        android:textSize="19sp"
                        android:textStyle="bold"
                        android:layout_marginTop="12dp" />

                    <!-- Subtitle Wali Kelas -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="3dp">

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:src="@drawable/ic_modern_tugas"
                            app:tint="#A5B4FC"
                            android:layout_marginEnd="6dp" />

                        <TextView
                            android:id="@+id/tvWaliKelasNama"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Wali Kelas: -"
                            android:textColor="#A5B4FC"
                            android:textSize="11.5sp" />
                    </LinearLayout>

                    <!-- 3 WHITE STAT CARDS DI DALAM HERO -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:baselineAligned="false"
                        android:layout_marginTop="16dp">

                        <!-- Card 1: Total Tagihan -->
                        <androidx.cardview.widget.CardView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="4dp"
                            app:cardCornerRadius="14dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="#FFFFFF">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="10dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="TAGIHAN"
                                    android:textSize="9sp"
                                    android:textStyle="bold"
                                    android:textColor="#64748B" />

                                <TextView
                                    android:id="@+id/tvStatTotalTagihan"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Rp 0"
                                    android:textSize="12sp"
                                    android:textStyle="bold"
                                    android:textColor="#0F172A"
                                    android:maxLines="1"
                                    android:ellipsize="end"
                                    android:layout_marginTop="2dp" />

                                <TextView
                                    android:id="@+id/tvStatTotalSiswa"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="0 Siswa"
                                    android:textSize="9.5sp"
                                    android:textColor="#94A3B8"
                                    android:layout_marginTop="2dp" />
                            </LinearLayout>
                        </androidx.cardview.widget.CardView>

                        <!-- Card 2: Terbayar -->
                        <androidx.cardview.widget.CardView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginHorizontal="3dp"
                            app:cardCornerRadius="14dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="#FFFFFF">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="10dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="TERBAYAR"
                                    android:textSize="9sp"
                                    android:textStyle="bold"
                                    android:textColor="#059669" />

                                <TextView
                                    android:id="@+id/tvStatTerbayar"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Rp 0"
                                    android:textSize="12sp"
                                    android:textStyle="bold"
                                    android:textColor="#059669"
                                    android:maxLines="1"
                                    android:ellipsize="end"
                                    android:layout_marginTop="2dp" />

                                <TextView
                                    android:id="@+id/tvStatPersenTerbayar"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="0% Terkumpul"
                                    android:textSize="9.5sp"
                                    android:textColor="#059669"
                                    android:layout_marginTop="2dp" />
                            </LinearLayout>
                        </androidx.cardview.widget.CardView>

                        <!-- Card 3: Tunggakan / Sisa -->
                        <androidx.cardview.widget.CardView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="4dp"
                            app:cardCornerRadius="14dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="#FFFFFF">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="10dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="TUNGGAKAN"
                                    android:textSize="9sp"
                                    android:textStyle="bold"
                                    android:textColor="#DC2626" />

                                <TextView
                                    android:id="@+id/tvStatSisa"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Rp 0"
                                    android:textSize="12sp"
                                    android:textStyle="bold"
                                    android:textColor="#DC2626"
                                    android:maxLines="1"
                                    android:ellipsize="end"
                                    android:layout_marginTop="2dp" />

                                <TextView
                                    android:id="@+id/tvStatSiswaBelumLunas"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="0 Siswa"
                                    android:textSize="9.5sp"
                                    android:textColor="#DC2626"
                                    android:layout_marginTop="2dp" />
                            </LinearLayout>
                        </androidx.cardview.widget.CardView>

                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 3. ACTION BUTTONS (Cetak Rekap PDF & Export Excel) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp">

                <!-- Button Cetak Rekap PDF -->
                <LinearLayout
                    android:id="@+id/btnCetakRekapPdf"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:background="@drawable/bg_rounded_border"
                    android:backgroundTint="#4F46E5"
                    android:layout_marginEnd="6dp"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_printer"
                        app:tint="#FFFFFF" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cetak Rekap (PDF)"
                        android:textSize="11.5sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:layout_marginStart="6dp" />
                </LinearLayout>

                <!-- Button Export Excel -->
                <LinearLayout
                    android:id="@+id/btnExportExcel"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:background="@drawable/bg_rounded_border"
                    android:backgroundTint="#059669"
                    android:layout_marginStart="6dp"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_excel"
                        app:tint="#FFFFFF" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Export Excel"
                        android:textSize="11.5sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:layout_marginStart="6dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- 4. FILTER POS BAYAR DROPDOWN -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="8dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_modern_tugas"
                        app:tint="#4F46E5" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pos Bayar:"
                        android:textSize="11.5sp"
                        android:textStyle="bold"
                        android:textColor="#64748B"
                        android:layout_marginStart="6dp" />

                    <Spinner
                        android:id="@+id/spFilterPos"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_spinner_rounded"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:spinnerMode="dropdown" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 5. SEARCH BAR SISWA -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="12dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_search_24"
                        app:tint="#94A3B8" />

                    <EditText
                        android:id="@+id/etSearchSiswa"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:hint="Cari nama siswa atau NIS..."
                        android:textSize="12.5sp"
                        android:textColor="#0F172A"
                        android:textColorHint="#94A3B8"
                        android:background="@null"
                        android:layout_marginStart="8dp"
                        android:singleLine="true"
                        android:imeOptions="actionSearch" />

                    <ImageView
                        android:id="@+id/btnClearSearch"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_close_24"
                        app:tint="#94A3B8"
                        android:padding="2dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true"
                        android:visibility="gone" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 6. SECTION HEADER (TITLE, COUNTER, SORT) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DAFTAR TAGIHAN SISWA"
                    android:textSize="12.5sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.03"
                    android:textColor="#0F172A" />

                <TextView
                    android:id="@+id/tvDaftarCountBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="10.5sp"
                    android:textStyle="bold"
                    android:textColor="#3730A3"
                    android:background="@drawable/bg_rounded_border"
                    android:backgroundTint="#EEF2FF"
                    android:paddingHorizontal="7dp"
                    android:paddingVertical="2dp"
                    android:layout_marginStart="8dp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <!-- Sort Button -->
                <LinearLayout
                    android:id="@+id/btnSortOrder"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="?attr/selectableItemBackground"
                    android:padding="4dp">

                    <TextView
                        android:id="@+id/tvSortLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Urut Absen"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#4F46E5" />

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/ic_chevron_down"
                        app:tint="#4F46E5"
                        android:layout_marginStart="2dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- 7. FILTER STATUS CHIPS (SEMUA, BELUM LUNAS, LUNAS) -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Chip: Semua -->
                    <LinearLayout
                        android:id="@+id/chipSemua"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:background="@drawable/bg_rounded_border"
                        android:backgroundTint="#1E1B4B"
                        android:paddingHorizontal="12dp"
                        android:layout_marginEnd="6dp"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:id="@+id/tvChipSemua"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Semua (0)"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="#FFFFFF" />
                    </LinearLayout>

                    <!-- Chip: Belum Lunas -->
                    <LinearLayout
                        android:id="@+id/chipBelumLunas"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:background="@drawable/bg_rounded_border"
                        android:backgroundTint="#FFFFFF"
                        android:paddingHorizontal="12dp"
                        android:layout_marginEnd="6dp"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:id="@+id/tvChipBelumLunas"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Belum Lunas (0)"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="#DC2626" />
                    </LinearLayout>

                    <!-- Chip: Lunas -->
                    <LinearLayout
                        android:id="@+id/chipLunas"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:background="@drawable/bg_rounded_border"
                        android:backgroundTint="#FFFFFF"
                        android:paddingHorizontal="12dp"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:id="@+id/tvChipLunas"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Lunas (0)"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="#059669" />
                    </LinearLayout>

                </LinearLayout>
            </HorizontalScrollView>

            <!-- 8. LOADING INDICATOR (LOTTIE ANIMATION) -->
            <LinearLayout
                android:id="@+id/layoutLoadingContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginVertical="24dp"
                android:visibility="visible">

                <com.airbnb.lottie.LottieAnimationView
                    android:id="@+id/progressBarLoading"
                    android:layout_width="90dp"
                    android:layout_height="90dp"
                    app:lottie_url="https://lottie.host/ff71b2dd-787e-4f88-9f79-79f0eb2c8641/OqV9rU5oMu.json"
                    app:lottie_autoPlay="true"
                    app:lottie_loop="true" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Memuat data keuangan kelas..."
                    android:textColor="#64748B"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 9. EMPTY STATE -->
            <LinearLayout
                android:id="@+id/layoutEmptyState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="32dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_modern_tugas"
                    app:tint="#CBD5E1" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tidak ada data tagihan yang sesuai"
                    android:textSize="13.5sp"
                    android:textStyle="bold"
                    android:textColor="#64748B"
                    android:layout_marginTop="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Silakan sesuaikan kata kunci pencarian atau filter status tagihan."
                    android:textSize="11.5sp"
                    android:textColor="#94A3B8"
                    android:textAlignment="center"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <!-- 10. RECYCLER VIEW SISWA -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvKeuanganSiswa"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>

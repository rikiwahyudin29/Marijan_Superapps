<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_ringkasan_card"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Badges Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvBadgeJurusan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_blue_soft"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="TKJT • Kejuruan"
                android:textColor="#059669"
                android:textSize="11sp"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvBadgeDeadline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_red_soft"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="Besok, 23:59"
                android:textColor="#DC2626"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Task Title -->
        <TextView
            android:id="@+id/tvJudulTugas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Konfigurasi Routing OSPF MikroTik RB750"
            android:textColor="#0F172A"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- Bottom Row: Teacher & Action Button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_modern_profile"
                app:tint="#64748B" />

            <TextView
                android:id="@+id/tvGuruTugas"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Iwan Setiawan, S.T."
                android:textColor="#64748B"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/btnKumpulkanTugas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_button_dark_rounded"
                android:backgroundTint="#1E1B4B"
                android:paddingHorizontal="18dp"
                android:paddingVertical="8dp"
                android:text="Kumpulkan"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>

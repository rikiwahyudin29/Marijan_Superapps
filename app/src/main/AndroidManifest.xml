<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-feature android:name="android.hardware.camera.any" android:required="true" />
    
    <application
        tools:ignore="all"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MarijanCBT"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>


        <activity android:name=".LoginActivity" android:exported="false" />
        <activity android:name=".OtpActivity" android:exported="false" />
        <activity android:name=".DaftarTugasActivity" android:exported="false" />
        <activity android:name=".KumpulTugasActivity" android:exported="false" />
        <activity android:name=".FileViewerActivity" android:exported="false" />
        <activity android:name=".MateriBelajarActivity" android:exported="false" />
        <activity android:name=".NilaiRaportActivity" android:exported="false" />
        <activity
            android:name=".DashboardActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            tools:ignore="all" />
        <activity android:name=".JadwalActivity" android:exported="false" />
        <activity android:name=".KonfirmasiActivity" android:exported="false" />

        <activity
            android:name=".UjianActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:excludeFromRecents="true" />

        <activity
            android:name=".PresensiActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            tools:ignore="all" />

        <activity
            android:name=".KameraAbsenActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            tools:ignore="all" />
        <activity android:name=".IzinActivity" android:screenOrientation="portrait" tools:ignore="all" />
        <activity android:name=".RekapActivity" android:screenOrientation="portrait" tools:ignore="all" />
        <activity android:name=".KeuanganActivity" />
        <activity
            android:name=".PaymentActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            tools:ignore="all" />
        <activity
            android:name=".MateriTugasActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            tools:ignore="all" />
        <activity android:name=".DashboardGuruActivity" android:exported="false" android:screenOrientation="portrait" tools:ignore="all"/>
        <activity
            android:name=".CustomScannerActivity"
            android:screenOrientation="portrait"
            tools:ignore="all"
            android:stateNotNeeded="true"
            android:theme="@style/zxing_CaptureTheme" />
            
        <activity android:name=".JurnalMengajarActivity" android:screenOrientation="portrait" tools:ignore="all" />
        <activity android:name=".RekapMengajarActivity" android:screenOrientation="portrait" tools:ignore="all" />
        <activity android:name=".WaliKelasKehadiranActivity" android:screenOrientation="portrait" tools:ignore="all" />
        <activity android:name=".WaliKelasAbsenHarianActivity" android:screenOrientation="portrait" tools:ignore="all" />
        <activity android:name=".WaliKelasKeuanganActivity" android:screenOrientation="portrait" tools:ignore="all" />
        <activity android:name=".PresensiKelasActivity" android:screenOrientation="portrait" tools:ignore="all" />
        <activity android:name=".JadwalMengajarActivity" android:screenOrientation="portrait" tools:ignore="all" />

        <!-- Receiver Pengingat Jadwal Mengajar Guru -->
        <receiver
            android:name=".PengingatMengajarReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="com.rtekmidev.marijancbt.ACTION_MULAI_MENGAJAR" />
                <action android:name="com.rtekmidev.marijancbt.ACTION_SELESAI_MENGAJAR" />
                <action android:name="com.rtekmidev.marijancbt.ACTION_TEST_PENGINGAT" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
